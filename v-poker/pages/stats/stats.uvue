<template>
	<view class="vp-page st-page">
		<view class="st-statusbar" :style="statusBarStyle"></view>
		<view class="st-topbar">
			<view class="st-back" hover-class="st-pressed" @click="goBack">
				<text class="st-back-text">← 返回</text>
			</view>
			<text class="st-title">个人战绩</text>
		</view>

		<view class="st-body">
			<!-- 数据总览 -->
			<view class="st-overview vp-card">
				<view class="st-row">
					<view class="st-cell">
						<text class="st-value">{{ statsStore.totalGames }}</text>
						<text class="st-label">总对局</text>
					</view>
					<view class="st-cell">
						<text class="st-value st-gold">{{ statsStore.winRate }}%</text>
						<text class="st-label">胜率</text>
					</view>
					<view class="st-cell">
						<text class="st-value">{{ statsStore.totalProfit }}</text>
						<text class="st-label">盈利</text>
					</view>
				</view>
				<view class="st-row">
					<view class="st-cell">
						<text class="st-value">{{ statsStore.bestPot }}</text>
						<text class="st-label">最大底池</text>
					</view>
					<view class="st-cell">
						<text class="st-value">{{ statsStore.bestHand }}</text>
						<text class="st-label">最佳牌型</text>
					</view>
					<view class="st-cell">
						<text class="st-value">{{ statsStore.maxStreak }}</text>
						<text class="st-label">连胜</text>
					</view>
				</view>
			</view>

			<!-- 玩法统计 -->
			<view class="st-section vp-card">
				<text class="st-section-title">各玩法统计</text>
				<view class="st-game-row">
					<text class="st-game-name">德州扑克</text>
					<text class="st-game-data">{{ getGameStat('texas_holdem') }}</text>
				</view>
				<view class="st-game-row">
					<text class="st-game-name">炸金花</text>
					<text class="st-game-data">{{ getGameStat('zha_jin_hua') }}</text>
				</view>
				<view class="st-game-row">
					<text class="st-game-name">牛牛</text>
					<text class="st-game-data">{{ getGameStat('niu_niu') }}</text>
				</view>
				<view class="st-game-row">
					<text class="st-game-name">三公</text>
					<text class="st-game-data">{{ getGameStat('san_gong') }}</text>
				</view>
			</view>

			<vp-empty v-if="statsStore.totalGames == 0 && !statsStore.loading" title="暂无对局数据" description="开始第一局后这里会显示你的战绩" />
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { useStatsStore } from '@/store/stats.uts'

	const statsStore = useStatsStore()
	const statusBarStyle = ref('height: 0px')

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
	})

	onShow(() => {
		statsStore.loadStats()
	})

	const getGameStat = (type: string): string => {
		const list = statsStore.gameStats
		for (let i = 0; i < list.length; i++) {
			if (list[i].gameType == type) {
				return `${list[i].games} 局 · 胜率 ${list[i].winRate}%`
			}
		}
		return '0 局 · 胜率 0%'
	}

	const goBack = () => {
		uni.navigateBack()
	}
</script>

<style lang="scss">
	.st-page { flex: 1; background-color: $vp-ink; }
	.st-statusbar { width: 100%; }
	.st-topbar {
		flex-direction: row; align-items: center; height: 52px;
		padding-left: 16px; padding-right: 16px;
		background-color: $vp-surface;
		border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: $vp-border;
	}
	.st-back { height: 32px; flex-direction: row; align-items: center; }
	.st-pressed { opacity: 0.75; }
	.st-back-text { color: $vp-text; font-size: 14px; }
	.st-title { color: $vp-text; font-size: 16px; font-weight: bold; margin-left: 16px; }
	.st-body { flex: 1; padding: 14px 16px; }
	.st-overview { padding: 16px; margin-bottom: 12px; }
	.st-row { flex-direction: row; justify-content: space-around; }
	.st-row + .st-row { margin-top: 16px; }
	.st-cell { flex: 1; flex-direction: column; align-items: center; }
	.st-value { color: $vp-text; font-size: 18px; font-weight: bold; }
	.st-gold { color: $vp-gold; }
	.st-label { color: $vp-muted; font-size: 11px; margin-top: 4px; }
	.st-section { padding: 16px; margin-bottom: 12px; }
	.st-section-title { color: $vp-gold; font-size: 15px; font-weight: bold; margin-bottom: 12px; }
	.st-game-row {
		flex-direction: row; justify-content: space-between; align-items: center;
		height: 40px;
	}
	.st-game-row + .st-game-row { border-top-width: 1px; border-top-style: solid; border-top-color: $vp-border; }
	.st-game-name { color: $vp-text; font-size: 14px; }
	.st-game-data { color: $vp-muted; font-size: 12px; }
</style>
