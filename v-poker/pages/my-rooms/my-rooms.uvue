<template>
	<view class="vp-page mr-page">
		<view class="mr-container">
			<!-- 左侧边栏（复用大厅风格） -->
			<view class="mr-sidebar">
				<view class="mr-logo">
					<view class="mr-logo-icon">
						<text class="mr-logo-spade">♠</text>
					</view>
					<text class="mr-logo-title">V-POKER</text>
				</view>
				<view class="mr-nav">
					<view class="mr-nav-item" hover-class="mr-pressed" @click="goHall">
						<text class="mr-nav-icon">◉</text>
						<text class="mr-nav-label">大厅</text>
					</view>
					<view class="mr-nav-item mr-nav-active">
						<text class="mr-nav-icon">▦</text>
						<text class="mr-nav-label">我的房间</text>
					</view>
					<view class="mr-nav-item" hover-class="mr-pressed" @click="goRoomList">
						<text class="mr-nav-icon">☰</text>
						<text class="mr-nav-label">房间列表</text>
					</view>
					<view class="mr-nav-item" hover-class="mr-pressed" @click="goWallet">
						<text class="mr-nav-icon">◈</text>
						<text class="mr-nav-label">钱包</text>
					</view>
				</view>
				<view class="mr-user">
					<view class="mr-avatar">
						<text class="mr-avatar-text">玩</text>
					</view>
				</view>
			</view>

			<!-- 右侧主内容 -->
			<view class="mr-main">
				<view class="mr-header">
					<text class="mr-title">我的房间</text>
					<view class="mr-divider" />
					<text class="mr-count">{{ rooms.length }} 个房间</text>
				</view>

				<!-- 房间列表 -->
				<view v-if="rooms.length > 0" class="mr-list">
					<view v-for="room in rooms" :key="room.room_id" class="mr-room-card"
						hover-class="mr-room-hover" @click="enterRoom(room)">
						<view class="mr-room-icon">
							<text class="mr-room-icon-text">🎮</text>
						</view>
						<view class="mr-room-info">
							<text class="mr-room-name">{{ room.room_name || '未命名房间' }}</text>
							<view class="mr-room-meta">
								<text class="mr-room-tag">{{ gameName(room.game_type) }}</text>
								<text class="mr-room-dot">·</text>
								<text class="mr-room-tag">第 {{ room.current_round || 0 }}/{{ room.total_rounds }} 局</text>
							</view>
						</view>
						<view class="mr-room-status" :class="statusClass(room.status)">
							<text class="mr-room-status-text">{{ statusText(room.status) }}</text>
						</view>
						<view class="mr-room-enter">
							<text class="mr-room-enter-text">进入 ›</text>
						</view>
					</view>
				</view>

				<!-- 空状态 -->
				<view v-else class="mr-empty">
					<text class="mr-empty-icon">🎮</text>
					<text class="mr-empty-text">暂无进行中的房间</text>
					<text class="mr-empty-sub">从大厅选择游戏加入对局</text>
					<view class="mr-empty-btn" hover-class="mr-pressed" @click="goHall">
						<text class="mr-empty-btn-text">去大厅</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { useRoomStore } from '@/store/room.uts'

	const roomStore = useRoomStore()

	const rooms = ref([
		// 模拟数据
		{ room_id: '000001', room_name: '高级德州局', game_type: 'texas_holdem', status: 'playing', current_round: 5, total_rounds: 10 },
	])

	const gameName = (gt: string): string => {
		const map: Record<string, string> = {
			texas_holdem: '德州扑克',
			zha_jin_hua: '炸金花',
			niu_niu: '牛牛',
			san_gong: '三公',
		}
		return map[gt] || gt
	}

	const statusText = (s: string): string => {
		if (s == 'waiting') return '等待中'
		if (s == 'playing') return '进行中'
		if (s == 'finished') return '已结束'
		return s
	}

	const statusClass = (s: string): string => {
		if (s == 'playing') return 'mr-status-green'
		if (s == 'waiting') return 'mr-status-yellow'
		return 'mr-status-gray'
	}

	const enterRoom = (room: any) => {
		uni.navigateTo({ url: `/pages/table-texas/table-texas?room_id=${room.room_id}` })
	}

	const goHall = () => {
		uni.reLaunch({ url: '/pages/hall/hall' })
	}

	const goRoomList = () => {
		uni.navigateTo({ url: '/pages/room-list/room-list' })
	}

	const goWallet = () => {
		uni.navigateTo({ url: '/pages/wallet/wallet' })
	}
</script>

