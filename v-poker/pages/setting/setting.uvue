		flex-direction: row;
		align-items: center;
		height: 52px;
		padding-left: 16px;
		padding-right: 16px;
		background-color: $vp-surface;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: $vp-border;
	}

	.st-back {
		height: 32px;
		flex-direction: row;
		align-items: center;
	}

	.st-pressed {
		opacity: 0.75;
	}

	.st-back-text {
		color: $vp-text;
		font-size: 14px;
	}

	.st-brand {
		flex-direction: row;
		align-items: flex-end;
		margin-left: 16px;
	}

	.st-brand-text {
		color: $vp-text;
		font-size: 16px;
		font-weight: bold;
	}

	.st-brand-sub {
		color: $vp-muted;
		font-size: 10px;
		margin-left: 6px;
		margin-bottom: 2px;
	}

	.st-spacer {
		flex: 1;
	}

	.st-body {
		flex: 1;
		flex-direction: column;
		padding: 14px 16px;
	}

	.st-menu {
		flex-direction: column;
		padding-left: 16px;
		padding-right: 16px;
	}

	.st-item {
		height: 48px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.st-divider {
		height: 1px;
		background-color: $vp-border;
	}

	.st-item-text {
		color: $vp-text;
		font-size: 15px;
	}

	.st-item-danger {
		color: $vp-danger;
	}

	.st-item-arrow {
		color: $vp-faint;
		font-size: 18px;
	}

	.st-switch {
		min-width: 44px;
		height: 24px;
		border-radius: 12px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding-left: 8px;
		padding-right: 8px;
	}

	.st-switch-on {
		background-color: $vp-gold;
	}

	.st-switch-off {
		background-color: $vp-surface-3;
		border-width: 1px;
		border-style: solid;
		border-color: $vp-border;
	}

	.st-switch-text {
		color: #14100a;
