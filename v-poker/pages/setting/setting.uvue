<template>
	<view class="vp-page st-page">
		<view class="st-statusbar" :style="statusBarStyle"></view>

		<view class="st-topbar">
			<view class="st-back" hover-class="st-pressed" @click="goBack">
				<text class="st-back-text">← 返回</text>
			</view>
			<view class="st-brand">
				<text class="st-brand-text">设置</text>
				<text class="st-brand-sub">V-POKER · 金樽俱乐部 v1.0.0</text>
			</view>
			<view class="st-spacer"></view>
		</view>

		<view class="st-body">
			<view class="st-menu vp-card">
				<view class="st-item" hover-class="st-pressed" @click="toggleAudio">
					<text class="st-item-text">游戏音效</text>
					<view class="st-switch" :class="audioEnabled ? 'st-switch-on' : 'st-switch-off'">
						<text class="st-switch-text">{{ audioEnabled ? '开' : '关' }}</text>
					</view>
				</view>
				<view class="st-divider"></view>
				<view class="st-item" hover-class="st-pressed" @click="onLogout">
					<text class="st-item-text st-item-danger">退出登录</text>
					<text class="st-item-arrow">›</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'
	import { setAudioEnabled, isAudioEnabled } from '@/utils/audio.uts'

	const auth = useAuthStore()

	const statusBarStyle = ref('height: 0px')
	const audioEnabled = ref(isAudioEnabled())

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
		const saved = uni.getStorageSync('audio_enabled')
		if (saved != null && `${saved}`.length > 0) {
			audioEnabled.value = `${saved}` == 'true'
			setAudioEnabled(audioEnabled.value)
		}
	})

	onShow(() => {
		auth.restore()
	})

	const toggleAudio = () => {
		audioEnabled.value = !audioEnabled.value
		setAudioEnabled(audioEnabled.value)
		uni.setStorageSync('audio_enabled', audioEnabled.value ? 'true' : 'false')
		uni.showToast({ title: audioEnabled.value ? '音效已开启' : '音效已关闭', icon: 'none' })
	}

	const onLogout = () => {
		uni.showModal({
			title: '提示',
			content: '确定退出登录？',
			success: (res) => {
				if (res.confirm) {
					auth.logout()
				}
			}
		})
	}

	const goBack = () => {
		uni.navigateBack()
	}
</script>

<style lang="scss">
