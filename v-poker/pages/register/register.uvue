		position: absolute;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(10, 14, 20, 0.75) 0%, rgba(10, 14, 20, 0.55) 50%, rgba(10, 14, 20, 0.8) 100%);
	}

	.rg-statusbar {
		width: 100%;
	}

	.rg-body {
		flex: 1;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 0 48px;
	}

	.rg-hero {
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		margin-right: 48px;
	}

	.rg-badge {
		width: 56px;
		height: 64px;
		background: linear-gradient(180deg, #1c232e 0%, #0a0e14 100%);
		border-width: 2px;
		border-style: solid;
		border-color: $vp-gold;
		border-radius: 7px 7px 28px 28px;
		align-items: center;
		justify-content: center;
		margin-bottom: 14px;
	}

	.rg-badge-spade {
		color: $vp-gold;
		font-size: 28px;
		font-weight: bold;
	}

	.rg-logo {
		color: $vp-gold;
		font-size: 42px;
		font-weight: bold;
		letter-spacing: 6px;
	}

	.rg-club {
		color: $vp-text;
		font-size: 15px;
		letter-spacing: 6px;
		margin-top: 4px;
	}

	.rg-slogan {
		color: $vp-muted;
		font-size: 14px;
		margin-top: 12px;
	}

	.rg-hero-tip {
		color: $vp-muted;
		font-size: 13px;
		margin-top: 10px;
	}

	.rg-form {
		width: 340px;
		flex-direction: column;
		padding: 24px;
	}

	.rg-form-title {
		color: $vp-text;
		font-size: 18px;
		font-weight: bold;
		margin-bottom: 18px;
	}

	.rg-field {
		flex-direction: column;
		margin-bottom: 14px;
	}

	.rg-field-label {
		color: $vp-muted;
		font-size: 12px;
		margin-bottom: 6px;
	}

	.rg-input {
		width: 100%;
		height: 46px;
		background-color: $vp-surface-2;
		border-radius: $vp-radius-sm;
		border-width: 1px;
		border-style: solid;
		border-color: $vp-border;
		color: $vp-text;
		font-size: 15px;
		padding-left: 14px;
		padding-right: 14px;
	}

	.rg-submit {
		flex-direction: row;
		margin-top: 6px;
	}

	.rg-back {
		height: 34px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-top: 12px;
	}

	.rg-pressed {
		opacity: 0.75;
