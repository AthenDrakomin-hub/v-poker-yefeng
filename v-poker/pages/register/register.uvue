<template>
	<view class="vp-page rg-page">
		<!-- 背景图 -->
		<image class="rg-bg" src="/static/login-bg.png" mode="aspectFill" />
		<view class="rg-bg-mask" />

		<!-- 顶部装饰光效 -->
		<view class="rg-glow-top" />

		<view class="rg-statusbar" :style="statusBarStyle"></view>

		<view class="rg-container">
			<!-- 顶部品牌区 -->
			<view class="rg-hero">
				<view class="rg-logo-wrap">
					<view class="rg-logo-ring">
						<view class="rg-logo-shield">
							<text class="rg-logo-spade">♠</text>
						</view>
					</view>
					<text class="rg-brand">V-POKER</text>
					<text class="rg-club">金樽俱乐部</text>
					<view class="rg-divider" />
					<text class="rg-slogan">创建你的专属对局</text>
				</view>
			</view>

			<!-- 底部玻璃拟态表单 -->
			<view class="rg-card">
				<view class="rg-card-inner">
					<text class="rg-title">注册账号</text>
					<text class="rg-subtitle">加入金樽俱乐部，开启你的牌局</text>

					<!-- 用户名输入 -->
					<view class="rg-input-group">
						<view class="rg-input-icon-wrap">
							<text class="rg-input-icon">👤</text>
						</view>
						<input class="rg-input" type="text" placeholder="3-20位字母或数字" placeholder-class="rg-input-ph"
							:value="username" @input="onUsernameInput" />
					</view>

					<!-- 密码输入 -->
					<view class="rg-input-group">
						<view class="rg-input-icon-wrap">
							<text class="rg-input-icon">🔒</text>
						</view>
						<input class="rg-input" type="text" :password="true" placeholder="至少4位密码" placeholder-class="rg-input-ph"
							:value="password" @input="onPasswordInput" />
					</view>

					<!-- 确认密码输入 -->
					<view class="rg-input-group">
						<view class="rg-input-icon-wrap">
							<text class="rg-input-icon">✅</text>
						</view>
						<input class="rg-input" type="text" :password="true" placeholder="再次输入密码" placeholder-class="rg-input-ph"
							:value="password2" @input="onPassword2Input" />
					</view>

					<!-- 注册按钮 -->
					<view class="rg-btn-wrap">
						<view class="rg-register-btn" :class="{ 'rg-btn-loading': submitting }" @click="onRegister">
							<text class="rg-register-text">{{ submitting ? '注册中...' : '注 册' }}</text>
						</view>
					</view>

					<!-- 返回登录链接 -->
					<view class="rg-footer">
						<text class="rg-footer-text">已有账号？</text>
						<text class="rg-footer-link" @click="goBack">返回登录</text>
					</view>
				</view>
			</view>

			<!-- 底部版权 -->
			<view class="rg-copyright">
				<text class="rg-copyright-text">V-POKER 金樽俱乐部 · v1.0.0</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'

	const auth = useAuthStore()

	const username = ref('')
	const password = ref('')
	const password2 = ref('')
	const statusBarStyle = ref('height: 0px')
	const submitting = ref(false)

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
	})

	const onUsernameInput = (e: UniInputEvent) => {
		username.value = e.detail.value
	}

	const onPasswordInput = (e: UniInputEvent) => {
		password.value = e.detail.value
	}

	const onPassword2Input = (e: UniInputEvent) => {
		password2.value = e.detail.value
	}

	const onRegister = async () => {
		const name = username.value.trim()
		const pwd = password.value
		const pwd2 = password2.value
		if (name.length == 0) {
			uni.showToast({ title: '请输入用户名', icon: 'none' })
			return
		}
		if (pwd.length == 0) {
			uni.showToast({ title: '请输入密码', icon: 'none' })
			return
		}
		if (pwd != pwd2) {
			uni.showToast({ title: '两次密码不一致', icon: 'none' })
			return
		}
		if (submitting.value) {
			return
		}
		submitting.value = true
		uni.showLoading({ title: '注册中', mask: true })
		try {
			const ok = await auth.register(name, pwd)
			uni.hideLoading()
			if (ok) {
				uni.showToast({ title: '注册成功，请登录', icon: 'none' })
				setTimeout(() => {
					uni.navigateBack()
				}, 800)
			} else {
				uni.showToast({ title: '注册失败', icon: 'none' })
			}
		} catch (err) {
			uni.hideLoading()
			console.error('register failed', err)
		} finally {
			submitting.value = false
		}
	}

	const goBack = () => {
		uni.navigateBack()
	}
</script>

