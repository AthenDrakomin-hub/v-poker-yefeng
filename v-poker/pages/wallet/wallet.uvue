					<view class="wl-nav-item" hover-class="wl-pressed" @click="goHall">
						<text class="wl-nav-icon">◉</text>
						<text class="wl-nav-label">大厅</text>
					</view>
					<view class="wl-nav-item" hover-class="wl-pressed" @click="goMyRooms">
						<text class="wl-nav-icon">▦</text>
						<text class="wl-nav-label">我的房间</text>
					</view>
					<view class="wl-nav-item" hover-class="wl-pressed" @click="goRoomList">
						<text class="wl-nav-icon">☰</text>
						<text class="wl-nav-label">房间列表</text>
					</view>
					<view class="wl-nav-item wl-nav-active">
						<text class="wl-nav-icon">◈</text>
						<text class="wl-nav-label">钱包</text>
					</view>
				</view>
			</view>

			<!-- 主内容 -->
			<view class="wl-main">
				<view class="wl-header">
					<text class="wl-title">钱包</text>
					<view class="wl-divider" />
					<text class="wl-sub">筹码账本</text>
				</view>

				<!-- 余额卡片 -->
				<view class="wl-balance-card">
					<view class="wl-balance-info">
						<text class="wl-balance-label">可用筹码</text>
						<text class="wl-balance-value">100,000</text>
						<text class="wl-balance-sub">冻结 0 · 100% 可用</text>
					</view>
					<view class="wl-balance-icon">
						<text class="wl-balance-icon-text">💰</text>
					</view>
				</view>

				<!-- 转赠卡片 -->
				<view class="wl-transfer-card">
					<view class="wl-transfer-head">
						<text class="wl-transfer-title">筹码转赠</text>
						<text class="wl-transfer-fee">手续费 0.1%</text>
					</view>
					<view class="wl-field">
						<text class="wl-field-label">收款玩家 ID</text>
						<view class="wl-input-wrap">
							<input class="wl-input" type="text" placeholder="请输入玩家 ID" v-model="toUserId" />
						</view>
					</view>
					<view class="wl-field">
						<text class="wl-field-label">转账金额</text>
						<view class="wl-input-wrap">
							<input class="wl-input" type="number" placeholder="请输入金额" v-model="amount" />
						</view>
					</view>
					<view class="wl-transfer-btn" hover-class="wl-pressed" @click="doTransfer">
						<text class="wl-transfer-btn-text">确认转账</text>
					</view>
				</view>

				<!-- 流水记录 -->
				<view class="wl-flow-card">
					<view class="wl-flow-head">
						<text class="wl-flow-title">资金流水</text>
					</view>
					<view class="wl-flow-list">
						<view v-for="item in flowList" :key="item.id" class="wl-flow-item">
							<view class="wl-flow-left">
								<text class="wl-flow-type">{{ item.type }}</text>
								<text class="wl-flow-time">{{ item.time }}</text>
							</view>
							<text class="wl-flow-amount" :class="item.amount > 0 ? 'wl-flow-plus' : 'wl-flow-minus'">
								{{ item.amount > 0 ? '+' : '' }}{{ item.amount }}
							</text>
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	const toUserId = ref('')
	const amount = ref('')

	const flowList = ref([
		{ id: 1, type: '对局结算', time: '2026-09-24 14:30', amount: 5000 },
		{ id: 2, type: '代理转账', time: '2026-09-24 13:15', amount: 10000 },
		{ id: 3, type: '对局结算', time: '2026-09-24 11:20', amount: -2000 },
		{ id: 4, type: '系统发放', time: '2026-09-23 20:00', amount: 50000 },
	])

	const doTransfer = () => {
		if (toUserId.value.length == 0) {
			uni.showToast({ title: '请输入玩家 ID', icon: 'none' })
			return
		}
		if (amount.value.length == 0) {
			uni.showToast({ title: '请输入金额', icon: 'none' })
			return
		}
		uni.showToast({ title: '转账成功', icon: 'success' })
	}

	const goHall = () => {
		uni.reLaunch({ url: '/pages/hall/hall' })
	}

	const goMyRooms = () => {
		uni.navigateTo({ url: '/pages/my-rooms/my-rooms' })
	}

	const goRoomList = () => {
		uni.navigateTo({ url: '/pages/room-list/room-list' })
	}
</script>

