	}

	.wl-note {
		color: $vp-faint;
		font-size: 11px;
	}

	.wl-field {
		flex-direction: column;
		margin-bottom: 10px;
	}

	.wl-field-label {
		color: $vp-muted;
		font-size: 11px;
		margin-bottom: 5px;
	}

	.wl-transfer-btn {
		flex-direction: row;
		margin-top: 4px;
	}

	.wl-flow-panel {
		flex: 1;
		margin-top: 12px;
	}

	.wl-list {
		flex: 1;
	}

	.wl-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-top: 11px;
		padding-bottom: 11px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: $vp-border;
	}

	.wl-row-main {
		flex-direction: column;
	}

	.wl-row-title {
		color: $vp-text;
		font-size: 14px;
		font-weight: bold;
	}

	.wl-row-sub {
		color: $vp-muted;
		font-size: 12px;
		margin-top: 2px;
	}

	.wl-row-amount {
		font-size: 15px;
		font-weight: bold;
	}

	.wl-amount-in {
		color: $vp-success;
	}

	.wl-amount-out {
		color: $vp-danger;
	}

	.wl-more {
		flex-direction: row;
		justify-content: center;
		padding-top: 16px;
		padding-bottom: 16px;
	}

