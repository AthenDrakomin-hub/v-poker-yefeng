		flex: 1;
	}

	.wl-refresh {
		height: 30px;
		background-color: $vp-surface-2;
		border-radius: $vp-radius-sm;
		border-width: 1px;
		border-style: solid;
		border-color: $vp-border;
		flex-direction: row;
		align-items: center;
		padding-left: 12px;
		padding-right: 12px;
	}

	.wl-refresh-text {
		color: $vp-text;
		font-size: 12px;
	}

	.wl-body {
		flex: 1;
		flex-direction: column;
		padding: 14px 16px;
	}

	.wl-top {
		flex-direction: row;
	}

	.wl-panel {
		flex-direction: column;
		padding: 14px;
	}

	.wl-balance-panel {
		flex: 1;
		margin-right: 12px;
	}

	.wl-label {
		color: $vp-muted;
		font-size: 12px;
	}

	.wl-balance {
		color: $vp-gold;
		font-size: 38px;
		font-weight: bold;
		margin-top: 4px;
	}

	.wl-sub {
		color: $vp-muted;
		font-size: 12px;
		margin-top: 6px;
	}

	.wl-transfer-panel {
		width: 300px;
	}

	.wl-panel-head {
		flex-direction: row;
