<template>
	<view class="vp-page wl-page">
		<view class="wl-container">
			<!-- 侧边栏 -->
			<view class="wl-sidebar">
				<view class="wl-logo">
					<view class="wl-logo-icon">
						<text class="wl-logo-spade">♠</text>
