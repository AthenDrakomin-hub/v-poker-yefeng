<template>
	<view class="vp-page lg-page">
		<!-- 背景图 + 暗化叠加 -->
		<image class="lg-bg" src="/static/hall-bg.png" mode="aspectFill" />
		<view class="lg-bg-mask" />

		<view class="lg-statusbar" :style="statusBarStyle"></view>

		<view class="lg-body">
			<view class="lg-hero">
				<!-- 盾牌徽章 Logo -->
				<view class="lg-badge">
					<text class="lg-badge-spade">♠</text>
				</view>
				<text class="lg-logo">V-POKER</text>
				<text class="lg-club">金 樽 俱 乐 部</text>
				<text class="lg-slogan">一手牌 · 一世界</text>
				<view class="lg-hero-tags">
					<view class="lg-tag"><text class="lg-tag-text">私密对局</text></view>
					<view class="lg-tag"><text class="lg-tag-text">安全结算</text></view>
					<view class="lg-tag"><text class="lg-tag-text">即来即玩</text></view>
				</view>
			</view>

			<view class="lg-form vp-card">
				<text class="lg-form-title">账号登录</text>

				<view class="lg-field">
					<text class="lg-field-label">用户名</text>
					<input class="lg-input" type="text" placeholder="请输入用户名" :value="username"
						@input="onUsernameInput" />
				</view>

				<view class="lg-field">
					<text class="lg-field-label">密码</text>
					<input class="lg-input" type="text" :password="true" placeholder="请输入密码" :value="password"
						@input="onPasswordInput" />
				</view>

				<view class="lg-submit">
					<vp-button type="gold" size="lg" block :loading="submitting" text="登 录" @click="onLogin" />
				</view>

				<view class="lg-register" hover-class="lg-pressed" @click="goRegister">
					<text class="lg-register-text">还没有账号？去注册</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'

	const auth = useAuthStore()

	const username = ref('')
	const password = ref('')
	const statusBarStyle = ref('height: 0px')
	const submitting = ref(false)

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
	})

	onShow(() => {
		auth.restore()
		if (auth.isLoggedIn) {
			uni.reLaunch({ url: '/pages/hall/hall' })
		}
	})

	const onUsernameInput = (e: UniInputEvent) => {
		username.value = e.detail.value
	}

	const onPasswordInput = (e: UniInputEvent) => {
		password.value = e.detail.value
	}

	const onLogin = async () => {
		const name = username.value.trim()
		const pwd = password.value
		if (name.length == 0) {
			uni.showToast({ title: '请输入用户名', icon: 'none' })
			return
		}
		if (pwd.length == 0) {
			uni.showToast({ title: '请输入密码', icon: 'none' })
			return
		}
		if (submitting.value) {
			return
		}
		submitting.value = true
		uni.showLoading({ title: '登录中', mask: true })
		try {
			const ok = await auth.login(name, pwd)
			uni.hideLoading()
			if (ok) {
				uni.reLaunch({ url: '/pages/hall/hall' })
			} else {
				uni.showToast({ title: '登录失败', icon: 'none' })
			}
		} catch (err) {
			uni.hideLoading()
			console.error('login failed', err)
		} finally {
			submitting.value = false
		}
	}

	const goRegister = () => {
		uni.navigateTo({ url: '/pages/register/register' })
	}
</script>

