		letter-spacing: 6px;
	}

	.lg-club {
		color: $vp-text;
		font-size: 16px;
		letter-spacing: 6px;
		margin-top: 4px;
	}

	.lg-slogan {
		color: $vp-muted;
		font-size: 14px;
		margin-top: 14px;
		letter-spacing: 2px;
	}

	.lg-hero-tags {
		flex-direction: row;
		margin-top: 20px;
	}

	.lg-tag {
		background-color: rgba(212, 175, 55, 0.1);
		border-width: 1px;
		border-style: solid;
		border-color: rgba(212, 175, 55, 0.28);
		border-radius: 999px;
		padding: 4px 12px;
		margin-right: 10px;
	}

	.lg-tag-text {
		color: $vp-gold;
		font-size: 11px;
	}

	.lg-form {
		width: 340px;
		flex-direction: column;
		padding: 24px;
		background-color: rgba(20, 25, 34, 0.92);
