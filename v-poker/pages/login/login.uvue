<template>
	<view class="vp-page lg-page">
		<!-- 背景图 -->
		<image class="lg-bg" src="/static/login-bg.png" mode="aspectFill" />
		<view class="lg-bg-mask" />

		<!-- 顶部装饰光效 -->
		<view class="lg-glow-top" />
		<view class="lg-glow-bottom" />

		<view class="lg-statusbar" :style="statusBarStyle"></view>

		<view class="lg-container">
			<!-- 顶部品牌区 -->
			<view class="lg-hero">
				<view class="lg-logo-wrap">
					<view class="lg-logo-ring">
						<view class="lg-logo-shield">
							<text class="lg-logo-spade">♠</text>
						</view>
					</view>
					<text class="lg-brand">V-POKER</text>
					<text class="lg-club">金樽俱乐部</text>
					<view class="lg-divider" />
					<text class="lg-slogan">一手牌 · 一世界</text>
				</view>
			</view>

			<!-- 底部玻璃拟态表单 -->
			<view class="lg-card">
				<view class="lg-card-inner">
					<text class="lg-title">欢迎回来</text>
					<text class="lg-subtitle">登录你的金樽俱乐部账号</text>

					<!-- 用户名输入 -->
					<view class="lg-input-group">
						<view class="lg-input-icon-wrap">
							<text class="lg-input-icon">👤</text>
						</view>
						<input class="lg-input" type="text" placeholder="请输入用户名" placeholder-class="lg-input-ph"
							:value="username" @input="onUsernameInput" />
					</view>

					<!-- 密码输入 -->
					<view class="lg-input-group">
						<view class="lg-input-icon-wrap">
							<text class="lg-input-icon">🔒</text>
						</view>
						<input class="lg-input" type="text" :password="true" placeholder="请输入密码" placeholder-class="lg-input-ph"
							:value="password" @input="onPasswordInput" />
					</view>

					<!-- 登录按钮 -->
					<view class="lg-btn-wrap">
						<view class="lg-login-btn" :class="{ 'lg-btn-loading': submitting }" @click="onLogin">
							<text class="lg-login-text">{{ submitting ? '登录中...' : '登 录' }}</text>
						</view>
					</view>

					<!-- 注册链接 -->
					<view class="lg-footer">
						<text class="lg-footer-text">还没有账号？</text>
						<text class="lg-footer-link" @click="goRegister">立即注册</text>
					</view>
				</view>
			</view>

			<!-- 底部版权 -->
			<view class="lg-copyright">
				<text class="lg-copyright-text">V-POKER 金樽俱乐部 · v1.0.0</text>
				<text class="lg-copyright-sub">仅供娱乐 · 不涉及真实货币</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'

	const auth = useAuthStore()

	const username = ref('')
	const password = ref('')
	const statusBarStyle = ref('height: 0px')
	const submitting = ref(false)

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
	})

	onShow(() => {
		auth.restore()
		if (auth.isLoggedIn) {
			uni.reLaunch({ url: '/pages/hall/hall' })
		}
	})

	const onUsernameInput = (e: UniInputEvent) => {
		username.value = e.detail.value
	}

	const onPasswordInput = (e: UniInputEvent) => {
		password.value = e.detail.value
	}

	const onLogin = async () => {
		const name = username.value.trim()
		const pwd = password.value
		if (name.length == 0) {
			uni.showToast({ title: '请输入用户名', icon: 'none' })
			return
		}
		if (pwd.length == 0) {
			uni.showToast({ title: '请输入密码', icon: 'none' })
			return
		}
		if (submitting.value) {
			return
		}
		submitting.value = true
		uni.showLoading({ title: '登录中', mask: true })
		try {
			const ok = await auth.login(name, pwd)
			uni.hideLoading()
			if (ok) {
				uni.reLaunch({ url: '/pages/hall/hall' })
			} else {
				uni.showToast({ title: '登录失败', icon: 'none' })
			}
		} catch (err) {
			uni.hideLoading()
			console.error('login failed', err)
		} finally {
			submitting.value = false
		}
	}

	const goRegister = () => {
		uni.navigateTo({ url: '/pages/register/register' })
	}
</script>

