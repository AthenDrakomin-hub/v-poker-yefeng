		font-size: 12px;
		margin-bottom: 6px;
	}

	.lg-input {
		width: 100%;
		height: 46px;
		background-color: $vp-surface-2;
		border-radius: $vp-radius-sm;
		border-width: 1px;
		border-style: solid;
		border-color: $vp-border;
		color: $vp-text;
