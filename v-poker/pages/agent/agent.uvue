<template>
	<view class="vp-page ag-page">
		<view class="ag-statusbar" :style="statusBarStyle"></view>

		<view class="ag-topbar">
			<view class="ag-back" hover-class="ag-pressed" @click="goBack">
				<text class="ag-back-text">← 返回</text>
			</view>
			<view class="ag-brand">
				<text class="ag-brand-text">代理中心</text>
				<text class="ag-brand-sub">多级返佣 · 服务端结算</text>
			</view>
			<view class="ag-spacer"></view>
			<view class="ag-refresh" hover-class="ag-pressed" @click="load">
				<text class="ag-refresh-text">刷新</text>
			</view>
		</view>

		<view class="ag-body">
			<view class="ag-cards">
				<view class="ag-card vp-card">
					<text class="ag-label">代理余额</text>
					<text class="ag-value">{{ balanceText }}</text>
					<text class="ag-sub">下级玩家 {{ subPlayers }} 人</text>
				</view>

				<view class="ag-card vp-card">
					<text class="ag-label">累计佣金</text>
					<text class="ag-value">{{ commissionText }}</text>
					<text class="ag-sub">type = commission</text>
				</view>

				<view class="ag-card vp-card">
					<text class="ag-label">下级代理</text>
					<text class="ag-value">{{ childrenCount }}</text>
					<text class="ag-sub">直接下级</text>
				</view>
			</view>

			<vp-empty v-if="agent.errorMessage.length > 0" :title="agent.errorMessage"
				description="请确认当前账号为代理或管理员角色" action-text="重新加载" @action="load" />
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'
	import { useAgentStore } from '@/store/agent.uts'
	import { formatAmount } from '@/utils/format.uts'

	const auth = useAuthStore()
	const agent = useAgentStore()

	const statusBarStyle = ref('height: 0px')

	const balanceText = computed((): string => {
		const d = agent.dashboard
		if (d == null) {
			return '0'
		}
		const w = d.getJSON('wallet')
		if (w == null) {
			return '0'
		}
		const b = w.getNumber('balance')
		return formatAmount(b == null ? 0 : b)
	})

	const subPlayers = computed((): number => {
		const d = agent.dashboard
		if (d == null) {
			return 0
		}
		const n = d.getNumber('sub_players_count')
		return n == null ? 0 : n
	})

	const commissionText = computed((): string => {
		const c = agent.commission
		if (c == null) {
			return '0'
		}
		const t = c.getNumber('total_commission')
		return formatAmount(t == null ? 0 : t)
	})

	const childrenCount = computed((): number => {
		return agent.children.length
	})

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
	})

	onShow(() => {
		auth.restore()
		if (!auth.isLoggedIn) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		load()
	})

	const load = () => {
		agent.loadDashboard()
		agent.loadChildren(auth.userId)
		agent.loadCommission()
	}

	const goBack = () => {
		uni.navigateBack()
	}
</script>

<style lang="scss">
	.ag-page {
		flex: 1;
		background-color: $vp-ink;
	}

	.ag-statusbar {
		width: 100%;
	}

	.ag-topbar {
		flex-direction: row;
		align-items: center;
		height: 52px;
		padding-left: 16px;
		padding-right: 16px;
		background-color: $vp-surface;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: $vp-border;
	}

	.ag-back {
		height: 32px;
		flex-direction: row;
		align-items: center;
	}

	.ag-pressed {
		opacity: 0.75;
	}

	.ag-back-text {
		color: $vp-text;
		font-size: 14px;
	}

	.ag-brand {
		flex-direction: row;
		align-items: flex-end;
		margin-left: 16px;
	}

	.ag-brand-text {
		color: $vp-text;
		font-size: 16px;
		font-weight: bold;
	}

	.ag-brand-sub {
		color: $vp-muted;
		font-size: 10px;
		margin-left: 6px;
		margin-bottom: 2px;
	}

	.ag-spacer {
		flex: 1;
	}

	.ag-refresh {
		height: 30px;
		background-color: $vp-surface-2;
		border-radius: $vp-radius-sm;
		border-width: 1px;
		border-style: solid;
		border-color: $vp-border;
		flex-direction: row;
		align-items: center;
		padding-left: 12px;
		padding-right: 12px;
	}

	.ag-refresh-text {
		color: $vp-text;
		font-size: 12px;
	}

	.ag-body {
		flex: 1;
		flex-direction: column;
		padding: 14px 16px;
	}

	.ag-cards {
		flex-direction: row;
	}

	.ag-card {
		flex: 1;
		margin-right: 12px;
		padding: 16px;
		flex-direction: column;
	}

	.ag-label {
		color: $vp-muted;
		font-size: 12px;
	}

	.ag-value {
		color: $vp-gold;
		font-size: 26px;
		font-weight: bold;
		margin-top: 8px;
	}

	.ag-sub {
		color: $vp-muted;
		font-size: 12px;
		margin-top: 6px;
	}
</style>
