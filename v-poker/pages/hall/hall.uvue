<template>
	<view class="vp-page hall-page">
		<!-- 远景背景：城市夜景 + 暗化叠加 -->
		<image class="hall-bg" src="/static/hall-bg.png" mode="aspectFill" />
		<view class="hall-bg-mask" />

		<view class="hall-statusbar" :style="statusBarStyle"></view>

		<!-- 节日灯笼装饰：左右各一 -->
		<view class="hall-lantern hall-lantern-left">
			<view class="hall-lantern-rope" />
			<view class="hall-lantern-body">
				<text class="hall-lantern-fu">福</text>
			</view>
			<view class="hall-lantern-tassel" />
		</view>
		<view class="hall-lantern hall-lantern-right">
			<view class="hall-lantern-rope" />
			<view class="hall-lantern-body">
				<text class="hall-lantern-fu">春</text>
			</view>
			<view class="hall-lantern-tassel" />
		</view>

		<view class="hall-topbar">
			<view class="hall-brand">
				<view class="hall-brand-badge">
					<text class="hall-brand-spade">♠</text>
				</view>
				<view class="hall-brand-text-wrap">
					<text class="hall-brand-text">V-POKER</text>
					<text class="hall-brand-sub">金樽俱乐部</text>
				</view>
			</view>
			<view class="hall-notice">
				<text class="hall-notice-text">{{ notice }}</text>
			</view>
			<view class="hall-user" hover-class="hall-pressed" @click="goProfile">
				<vp-avatar :name="displayName" :size="34" />
				<view class="hall-user-meta">
					<text class="hall-user-name">{{ displayName }}</text>
					<text class="hall-user-coin">{{ balanceText }}</text>
				</view>
			</view>
		</view>

		<view class="hall-body">
			<view class="hall-rail">
				<view class="hall-rail-item hall-rail-active">
					<text class="hall-rail-text hall-rail-text-active">大厅</text>
				</view>
				<view class="hall-rail-item" hover-class="hall-pressed" @click="goWallet">
					<text class="hall-rail-text">钱包</text>
				</view>
				<view class="hall-rail-item" hover-class="hall-pressed" @click="goProfile">
					<text class="hall-rail-text">我的</text>
				</view>
			</view>

			<view class="hall-main">
				<view class="hall-main-head">
					<text class="hall-section">选择玩法</text>
					<text class="hall-section-note">对齐后端 4 种玩法 · 现金局</text>
				</view>

				<view class="hall-games">
					<view v-for="g in games" :key="g.game_type" class="hall-game vp-card" :style="gameCardStyle"
						hover-class="hall-game-pressed" @click="enterGame(g)">
						<view class="hall-game-top">
							<view class="hall-game-suit" :class="suitClass(g.game_type)">
								<text class="hall-game-suit-text" :class="suitTextClass(g.game_type)">{{ g.icon }}</text>
							</view>
							<view class="hall-game-badge">
								<text class="hall-game-badge-text">立即入局</text>
							</view>
						</view>
						<text class="hall-game-name">{{ g.name }}</text>
						<view class="hall-game-meta">
							<text class="hall-game-meta-text">底分 {{ baseOf(g.game_type) }}</text>
							<text class="hall-game-meta-text">2–6 人</text>
						</view>
						<view class="hall-game-foot">
							<text class="hall-game-code">{{ g.game_type }}</text>
							<text class="hall-game-enter">入局 ›</text>
						</view>
					</view>
				</view>

				<view class="hall-panel vp-card">
					<view class="hall-panel-head">
						<text class="hall-panel-title">我的对局</text>
						<text class="hall-section-note">加入代理创建的房间</text>
					</view>
					<view class="hall-actions">
						<vp-button type="gold" text="我的房间" @click="goMyRooms" />
						<view class="hall-gap"></view>
						<vp-button type="ghost" text="房间列表" @click="goRoomList" />
					</view>
				</view>
			</view>

			<view v-if="wide" class="hall-aside">
				<view class="hall-panel vp-card">
					<text class="hall-panel-title">快速加入</text>
					<view class="hall-field">
						<text class="hall-field-label">房号</text>
						<vp-input v-model="joinId" type="number" placeholder="6 位数字房号" />
					</view>
					<view class="hall-field">
						<text class="hall-field-label">密码（选填）</text>
						<vp-input v-model="joinPassword" type="password" placeholder="公开房可留空" />
					</view>
					<view class="hall-join-btn">
						<vp-button type="gold" text="加入房间" block @click="joinRoom" />
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'
	import { useWalletStore } from '@/store/wallet.uts'
	import { useLobbyStore } from '@/store/lobby.uts'
	import { GAME_ENTRIES, GameEntry, gameTypeRoute } from '@/utils/games.uts'
	import { formatAmount } from '@/utils/format.uts'

	const auth = useAuthStore()
	const wallet = useWalletStore()
	const lobby = useLobbyStore()

	const statusBarStyle = ref('height: 0px')
	const notice = ref('私密对局 · 安全结算 · 即来即玩')
	const games = GAME_ENTRIES
	const joinId = ref('')
	const joinPassword = ref('')
	const joining = ref(false)
	const wide = ref(true)

	const displayName = computed((): string => {
		return auth.nickname.length > 0 ? auth.nickname : auth.userId
	})

	const balanceText = computed((): string => {
		return `筹码 ${formatAmount(wallet.balance)}`
	})

	/** 宽屏时 4 列铺满，窄屏 2 列换行 */
	const gameCardStyle = computed((): string => {
		return wide.value ? 'flex: 1;' : 'width: 48%; margin-bottom: 12px;'
	})

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
		wide.value = info.windowWidth >= 1100
	})

	onShow(() => {
		auth.restore()
		if (!auth.isLoggedIn) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		wallet.refreshBalance()
	})

	const suitClass = (gt: string): string => {
		return gt == 'zha_jin_hua' || gt == 'san_gong' ? 'hall-game-suit-red' : 'hall-game-suit-black'
	}

	const suitTextClass = (gt: string): string => {
		return gt == 'zha_jin_hua' || gt == 'san_gong' ? 'hall-game-suit-text-red' : 'hall-game-suit-text-black'
	}

	const baseOf = (gt: string): string => {
		return gt == 'zha_jin_hua' ? '50' : '100'
	}

	const enterGame = (g: GameEntry) => {
		uni.navigateTo({ url: `/pages/room-list/room-list?game_type=${g.game_type}&name=${g.name}` })
	}

	const joinRoom = async () => {
		const id = joinId.value.trim()
		if (id.length == 0) {
			uni.showToast({ title: '请输入房号', icon: 'none' })
			return
		}
		if (joining.value) {
			return
		}
		joining.value = true
		try {
			const data = await lobby.joinRoom(id, joinPassword.value)
			if (data != null) {
				const gameType = (data as any).game_type || 'texas_holdem'
				const route = gameTypeRoute(gameType)
				uni.navigateTo({ url: `${route}?room_id=${id}` })
			}
		} catch (e) {
			console.error('joinRoom failed', e)
		} finally {
			joining.value = false
		}
	}

	const goRoomList = () => {
		uni.navigateTo({ url: '/pages/room-list/room-list' })
	}

	const goMyRooms = () => {
		uni.navigateTo({ url: '/pages/my-rooms/my-rooms' })
	}

	const goWallet = () => {
		uni.navigateTo({ url: '/pages/wallet/wallet' })
	}

	const goProfile = () => {
		uni.navigateTo({ url: '/pages/profile/profile' })
	}
</script>

