<template>
	<view class="vp-page hall-page">
		<!-- 背景图 -->
		<image class="hall-bg" src="/static/hall-bg.png" mode="aspectFill" />
		<view class="hall-bg-mask" />

		<view class="hall-statusbar" :style="statusBarStyle"></view>

		<!-- 顶部导航 -->
		<view class="hall-topbar">
			<view class="hall-brand">
				<view class="hall-brand-badge">
					<text class="hall-brand-spade">♠</text>
				</view>
				<view class="hall-brand-text-wrap">
					<text class="hall-brand-text">V-POKER</text>
					<text class="hall-brand-sub">金樽俱乐部</text>
				</view>
			</view>
			<view class="hall-user" hover-class="hall-pressed" @click="goProfile">
				<view class="hall-coin">
					<text class="hall-coin-icon">💰</text>
					<text class="hall-coin-text">{{ balanceText }}</text>
				</view>
				<vp-avatar :name="displayName" :size="32" />
			</view>
		</view>

		<!-- 游戏分类标签 -->
		<view class="hall-tabs">
			<view class="hall-tab hall-tab-active">
				<text class="hall-tab-text hall-tab-text-active">全部游戏</text>
			</view>
			<view class="hall-tab">
				<text class="hall-tab-text">热门推荐</text>
			</view>
			<view class="hall-tab">
				<text class="hall-tab-text">新游戏</text>
			</view>
		</view>

		<!-- 游戏卡片网格 -->
		<view class="hall-games">
			<view v-for="g in games" :key="g.game_type" class="hall-game"
				hover-class="hall-game-pressed" @click="enterGame(g)">
				<!-- 游戏背景图 -->
				<image class="hall-game-bg" :src="gameBg(g.game_type)" mode="aspectFill" />
				<view class="hall-game-mask" />

				<!-- 游戏内容 -->
				<view class="hall-game-content">
					<text class="hall-game-name">{{ g.name }}</text>
					<view class="hall-game-meta">
						<text class="hall-game-meta-text">底分 {{ baseOf(g.game_type) }}</text>
						<text class="hall-game-dot">·</text>
						<text class="hall-game-meta-text">2-9人</text>
					</view>
					<view class="hall-game-footer">
						<view class="hall-game-online">
							<view class="hall-online-dot" />
							<text class="hall-online-text">在线 {{ onlineCount(g.game_type) }}</text>
						</view>
						<view class="hall-game-btn">
							<text class="hall-game-btn-text">快速入局</text>
						</view>
					</view>
				</view>
			</view>
		</view>

		<!-- 底部操作 -->
		<view class="hall-bottom">
			<view class="hall-bottom-card">
				<view class="hall-bottom-item" hover-class="hall-pressed" @click="goMyRooms">
					<text class="hall-bottom-icon">🎮</text>
					<text class="hall-bottom-text">我的房间</text>
				</view>
				<view class="hall-bottom-divider" />
				<view class="hall-bottom-item" hover-class="hall-pressed" @click="goRoomList">
					<text class="hall-bottom-icon">📋</text>
					<text class="hall-bottom-text">房间列表</text>
				</view>
				<view class="hall-bottom-divider" />
				<view class="hall-bottom-item" hover-class="hall-pressed" @click="goWallet">
					<text class="hall-bottom-icon">💰</text>
					<text class="hall-bottom-text">钱包</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'
	import { useWalletStore } from '@/store/wallet.uts'
	import { useLobbyStore } from '@/store/lobby.uts'
	import { GAME_ENTRIES, GameEntry, gameTypeRoute } from '@/utils/games.uts'
	import { formatAmount } from '@/utils/format.uts'

	const auth = useAuthStore()
	const wallet = useWalletStore()
	const lobby = useLobbyStore()

	const statusBarStyle = ref('height: 0px')

	const games = GAME_ENTRIES

	const displayName = computed((): string => {
		return auth.userId || '玩家'
	})

	const balanceText = computed((): string => {
		return formatAmount(wallet.balance)
	})

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
	})

	onShow(() => {
		auth.restore()
		wallet.refresh()
	})

	const gameBg = (gt: string): string => {
		const map: Record<string, string> = {
			texas_holdem: '/static/table/texas-holdem.png',
			zha_jin_hua: '/static/table/zha-jin-hua.png',
			niu_niu: '/static/table/niu-niu.png',
			san_gong: '/static/table/san-gong.png',
			squid_game: '/static/table/squid-game.png',
			guandan: '/static/table/guandan.png',
			fight_bomb: '/static/table/fight_bomb.png',
			omaha: '/static/table/omaha.png',
			thirteen_water: '/static/table/thirteen_water.png',
			double_kong: '/static/table/double_kong.png',
			hong_wu: '/static/table/hong_wu.png',
			pineapple: '/static/table/pineapple.png',
			short_deck: '/static/table/short_deck.png',
		}
		return map[gt] || '/static/table/texas-holdem.png'
	}

	const baseOf = (gt: string): string => {
		if (gt == 'zha_jin_hua') return '50'
		if (gt == 'squid_game') return '200'
		return '100'
	}

	const onlineCount = (gt: string): number => {
		// 模拟在线人数
		const seed = gt.charCodeAt(0) + gt.charCodeAt(gt.length - 1)
		return 50 + (seed % 200)
	}

	const enterGame = (g: GameEntry) => {
		uni.navigateTo({ url: `/pages/room-list/room-list?game_type=${g.game_type}&name=${g.name}` })
	}

	const goMyRooms = () => {
		uni.navigateTo({ url: '/pages/my-rooms/my-rooms' })
	}

	const goRoomList = () => {
		uni.navigateTo({ url: '/pages/room-list/room-list' })
	}

	const goWallet = () => {
		uni.navigateTo({ url: '/pages/wallet/wallet' })
	}

	const goProfile = () => {
		uni.navigateTo({ url: '/pages/profile/profile' })
	}
</script>

