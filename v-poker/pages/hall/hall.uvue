<template>
	<view class="vp-page hall-page">
		<image src="/static/bg/lobby-bg.png" class="hall-bg" mode="aspectFill" />
		<view class="hall-container">
			<!-- 左侧固定窄边栏 220px -->
			<view class="hall-sidebar">
				<!-- 顶部 Logo -->
				<view class="hall-logo">
					<view class="hall-logo-icon">
						<text class="hall-logo-spade">♠</text>
					</view>
					<text class="hall-logo-title">V-POKER</text>
					<text class="hall-logo-sub">金樽俱乐部</text>
				</view>

				<!-- 中间导航 -->
				<view class="hall-nav">
					<view class="hall-nav-item hall-nav-active">
						<text class="hall-nav-icon">◉</text>
						<text class="hall-nav-label">大厅</text>
					</view>
					<view class="hall-nav-item" hover-class="hall-pressed" @click="goMyRooms">
						<text class="hall-nav-icon">▦</text>
						<text class="hall-nav-label">我的房间</text>
					</view>
					<view class="hall-nav-item" hover-class="hall-pressed" @click="goRoomList">
						<text class="hall-nav-icon">☰</text>
						<text class="hall-nav-label">房间列表</text>
					</view>
					<view class="hall-nav-item" hover-class="hall-pressed" @click="goWallet">
						<text class="hall-nav-icon">◈</text>
						<text class="hall-nav-label">钱包</text>
					</view>
				</view>

				<!-- 底部玩家信息 -->
				<view class="hall-user">
					<view class="hall-avatar">
						<text class="hall-avatar-text">玩</text>
					</view>
					<view class="hall-user-info">
						<text class="hall-user-name">{{ displayName }}</text>
						<view class="hall-balance">
							<text class="hall-balance-coin">●</text>
							<text class="hall-balance-text">{{ balanceText }}</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 右侧弹性主内容区 -->
			<view class="hall-main">
				<!-- 标题栏 -->
				<view class="hall-header">
					<view class="hall-header-left">
						<text class="hall-title">选择玩法</text>
						<view class="hall-divider" />
						<text class="hall-count">13 款游戏</text>
					</view>
				</view>

				<!-- 游戏卡片网格 3列 -->
				<view class="hall-games">
					<view v-for="g in games" :key="g.game_type" class="hall-card"
						hover-class="hall-card-hover" @click="enterGame(g)">
						<image class="hall-card-bg" :src="gameBg(g.game_type)" mode="aspectFill" />
						<view class="hall-card-overlay" />
						<view class="hall-card-body">
							<text class="hall-card-name">{{ g.name }}</text>
							<view class="hall-card-tags">
								<text class="hall-card-tag">底分 {{ baseOf(g.game_type) }}</text>
								<text class="hall-card-tag-dot">·</text>
								<text class="hall-card-tag">2-9人</text>
							</view>
							<view class="hall-card-footer">
								<view class="hall-card-online">
									<view class="hall-online-dot" />
									<text class="hall-online-text">{{ onlineCount(g.game_type) }} 人在线</text>
								</view>
								<view class="hall-card-btn">
									<text class="hall-card-btn-text">立即加入</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'
	import { useWalletStore } from '@/store/wallet.uts'
	import { GAME_ENTRIES, GameEntry } from '@/utils/games.uts'
	import { formatAmount } from '@/utils/format.uts'

	const auth = useAuthStore()
	const wallet = useWalletStore()

	const games = GAME_ENTRIES

	const displayName = computed((): string => {
		return auth.userId || '玩家'
	})

	const balanceText = computed((): string => {
		return formatAmount(wallet.balance)
	})

	onShow(() => {
		auth.restore()
		wallet.refresh()
	})

	const gameBg = (gt: string): string => {
		const map: Record<string, string> = {
			texas_holdem: '/static/table/texas-holdem.png',
			zha_jin_hua: '/static/table/zha-jin-hua.png',
			niu_niu: '/static/table/niu-niu.png',
			san_gong: '/static/table/san-gong.png',
			squid_game: '/static/table/squid-game.png',
			guandan: '/static/table/guandan.png',
			fight_bomb: '/static/table/fight_bomb.png',
			omaha: '/static/table/omaha.png',
			thirteen_water: '/static/table/thirteen_water.png',
			double_kong: '/static/table/double_kong.png',
			hong_wu: '/static/table/hong_wu.png',
			pineapple: '/static/table/pineapple.png',
			short_deck: '/static/table/short_deck.png',
		}
		return map[gt] || '/static/table/texas-holdem.png'
	}

	const baseOf = (gt: string): string => {
		if (gt == 'zha_jin_hua') return '50'
		if (gt == 'squid_game') return '200'
		return '100'
	}

	const onlineCount = (gt: string): number => {
		const seed = gt.charCodeAt(0) + gt.charCodeAt(gt.length - 1)
		return 50 + (seed % 200)
	}

	const enterGame = (g: GameEntry) => {
		uni.navigateTo({ url: `/pages/room-list/room-list?game_type=${g.game_type}&name=${g.name}` })
	}

	const goMyRooms = () => {
		uni.navigateTo({ url: '/pages/my-rooms/my-rooms' })
	}

	const goRoomList = () => {
		uni.navigateTo({ url: '/pages/room-list/room-list' })
	}

	const goWallet = () => {
		uni.navigateTo({ url: '/pages/wallet/wallet' })
	}
</script>

