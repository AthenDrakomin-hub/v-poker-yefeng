<template>
	<view class="vp-page rl-page">
		<view class="rl-container">
			<!-- 侧边栏 -->
			<view class="rl-sidebar">
				<view class="rl-logo">
					<view class="rl-logo-icon">
						<text class="rl-logo-spade">♠</text>
					</view>
					<text class="rl-logo-title">V-POKER</text>
				</view>
				<view class="rl-nav">
					<view class="rl-nav-item" hover-class="rl-pressed" @click="goHall">
						<text class="rl-nav-icon">◉</text>
						<text class="rl-nav-label">大厅</text>
					</view>
					<view class="rl-nav-item" hover-class="rl-pressed" @click="goMyRooms">
						<text class="rl-nav-icon">▦</text>
						<text class="rl-nav-label">我的房间</text>
					</view>
					<view class="rl-nav-item rl-nav-active">
						<text class="rl-nav-icon">☰</text>
						<text class="rl-nav-label">房间列表</text>
					</view>
					<view class="rl-nav-item" hover-class="rl-pressed" @click="goWallet">
						<text class="rl-nav-icon">◈</text>
						<text class="rl-nav-label">钱包</text>
					</view>
				</view>
			</view>

			<!-- 主内容 -->
			<view class="rl-main">
				<view class="rl-header">
					<text class="rl-title">房间列表</text>
					<view class="rl-divider" />
					<text class="rl-sub">{{ gameName }}</text>
				</view>

				<!-- 筛选标签 -->
				<view class="rl-filters">
					<view class="rl-filter rl-filter-active">
						<text class="rl-filter-text rl-filter-text-active">全部</text>
					</view>
					<view class="rl-filter">
						<text class="rl-filter-text">初级场</text>
					</view>
					<view class="rl-filter">
						<text class="rl-filter-text">中级场</text>
					</view>
					<view class="rl-filter">
						<text class="rl-filter-text">高级场</text>
					</view>
				</view>

				<!-- 房间卡片 -->
				<view class="rl-list">
					<view v-for="room in pagedRooms" :key="room.room_id" class="rl-room-card"
						hover-class="rl-room-hover" @click="joinRoom(room)">
						<view class="rl-room-level" :class="levelClass(room.level)">
							<text class="rl-room-level-text">{{ levelText(room.level) }}</text>
						</view>
						<view class="rl-room-info">
							<text class="rl-room-name">{{ room.room_name }}</text>
							<view class="rl-room-meta">
								<text class="rl-room-tag">盲注 {{ room.blind_small }}/{{ room.blind_big }}</text>
								<text class="rl-room-dot">·</text>
								<text class="rl-room-tag">{{ room.players }}/{{ room.max_players }} 人</text>
								<text class="rl-room-dot">·</text>
								<text class="rl-room-tag">{{ room.total_rounds }} 局</text>
							</view>
						</view>
						<view class="rl-room-join">
							<text class="rl-room-join-text">加入</text>
						</view>
					</view>
					<!-- 分页 -->
					<view v-if="totalPages > 1" class="rl-pagination">
						<view class="rl-page-btn" :class="{ 'rl-page-disabled': currentPage <= 1 }" @click="prevPage">
							<text class="rl-page-btn-text">‹</text>
						</view>
						<text class="rl-page-info">{{ currentPage }} / {{ totalPages }}</text>
						<view class="rl-page-btn" :class="{ 'rl-page-disabled': currentPage >= totalPages }" @click="nextPage">
							<text class="rl-page-btn-text">›</text>
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'

	const gameName = ref('全部游戏')
	const gameType = ref('')
	const currentPage = ref(1)
	const PAGE_SIZE = 6

	const rooms = ref([
		{ room_id: '100001', room_name: '休闲娱乐局', level: 'low', blind_small: 5, blind_big: 10, players: 3, max_players: 6, total_rounds: 10 },
		{ room_id: '100002', room_name: '高手对决', level: 'mid', blind_small: 25, blind_big: 50, players: 5, max_players: 9, total_rounds: 20 },
		{ room_id: '100003', room_name: 'VIP专属', level: 'high', blind_small: 100, blind_big: 200, players: 2, max_players: 6, total_rounds: 30 },
		{ room_id: '100004', room_name: '新手练习场', level: 'low', blind_small: 1, blind_big: 2, players: 4, max_players: 6, total_rounds: 10 },
		{ room_id: '100005', room_name: '午夜牌局', level: 'mid', blind_small: 50, blind_big: 100, players: 6, max_players: 9, total_rounds: 20 },
		{ room_id: '100006', room_name: '钻石俱乐部', level: 'high', blind_small: 200, blind_big: 400, players: 3, max_players: 6, total_rounds: 30 },
		{ room_id: '100007', room_name: '周末狂欢', level: 'low', blind_small: 10, blind_big: 20, players: 5, max_players: 9, total_rounds: 15 },
		{ room_id: '100008', room_name: '精英赛', level: 'mid', blind_small: 75, blind_big: 150, players: 4, max_players: 6, total_rounds: 25 },
		{ room_id: '100009', room_name: '王者对决', level: 'high', blind_small: 500, blind_big: 1000, players: 2, max_players: 6, total_rounds: 40 },
		{ room_id: '100010', room_name: '轻松一局', level: 'low', blind_small: 2, blind_big: 5, players: 6, max_players: 9, total_rounds: 10 },
		{ room_id: '100011', room_name: '黄金时段', level: 'mid', blind_small: 30, blind_big: 60, players: 7, max_players: 9, total_rounds: 20 },
		{ room_id: '100012', room_name: '至尊VIP', level: 'high', blind_small: 1000, blind_big: 2000, players: 4, max_players: 6, total_rounds: 50 },
	])

	const totalPages = computed((): number => {
		return Math.ceil(rooms.value.length / PAGE_SIZE)
	})

	const pagedRooms = computed((): any[] => {
		const start = (currentPage.value - 1) * PAGE_SIZE
		return rooms.value.slice(start, start + PAGE_SIZE)
	})

	const prevPage = () => {
		if (currentPage.value > 1) currentPage.value--
	}

	const nextPage = () => {
		if (currentPage.value < totalPages.value) currentPage.value++
	}

	onLoad((options) => {
		const gt = options.getString('game_type')
		const name = options.getString('name')
		if (gt != null) gameType.value = gt
		if (name != null) gameName.value = name
	})

	const levelText = (l: string): string => {
		if (l == 'low') return '初级'
		if (l == 'mid') return '中级'
		if (l == 'high') return '高级'
		return l
	}

	const levelClass = (l: string): string => {
		if (l == 'low') return 'rl-level-green'
		if (l == 'mid') return 'rl-level-yellow'
		if (l == 'high') return 'rl-level-red'
		return ''
	}

	const joinRoom = (room: any) => {
		uni.navigateTo({ url: `/pages/table-texas/table-texas?room_id=${room.room_id}` })
	}

	const goHall = () => {
		uni.reLaunch({ url: '/pages/hall/hall' })
	}

	const goMyRooms = () => {
		uni.navigateTo({ url: '/pages/my-rooms/my-rooms' })
	}

	const goWallet = () => {
		uni.navigateTo({ url: '/pages/wallet/wallet' })
	}
</script>

