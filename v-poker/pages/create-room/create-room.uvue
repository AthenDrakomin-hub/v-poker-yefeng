		flex: 1;
	}

	.cr-balance {
		height: 30px;
		background-color: $vp-surface-2;
		border-radius: 15px;
		flex-direction: row;
		align-items: center;
		padding-left: 12px;
		padding-right: 12px;
	}

	.cr-balance-text {
		color: $vp-gold;
		font-size: 12px;
	}

	.cr-body {
		flex: 1;
		flex-direction: row;
		padding: 14px 16px;
	}

	.cr-col {
		flex: 1;
		flex-direction: column;
		padding: 14px;
		margin-right: 12px;
	}

	.cr-label {
		color: $vp-muted;
		font-size: 12px;
		margin-bottom: 8px;
	}

	.cr-label-gap {
		margin-top: 14px;
	}

	.cr-games {
		flex-direction: row;
		flex-wrap: wrap;
		margin-bottom: 12px;
	}

	.cr-game {
		width: 72px;
		padding-top: 8px;
		padding-bottom: 8px;
		margin-right: 8px;
		margin-bottom: 8px;
		background-color: $vp-surface-2;
		border-radius: $vp-radius-sm;
		border-width: 1px;
		border-style: solid;
		border-color: transparent;
		flex-direction: column;
		align-items: center;
	}

	.cr-game-active {
		border-color: $vp-gold;
	}

	.cr-game-suit {
		font-size: 20px;
	}

	.cr-suit-black {
		color: #cfd6e0;
	}

	.cr-suit-red {
		color: #e2564a;
	}

	.cr-game-name {
		color: $vp-text;
		font-size: 11px;
		margin-top: 4px;
	}

	.cr-quicks {
		flex-direction: row;
		margin-bottom: 10px;
	}

	.cr-quick {
		padding: 5px 12px;
		margin-right: 8px;
		background-color: $vp-surface-2;
		border-radius: $vp-radius-sm;
		border-width: 1px;
		border-style: solid;
		border-color: $vp-border;
	}

	.cr-quick-active {
		background-color: $vp-gold;
		border-color: $vp-gold;
	}

	.cr-quick-text {
		font-size: 12px;
	}

	.cr-quick-text-normal {
		color: $vp-text;
	}

	.cr-quick-text-active {
		color: #14100a;
		font-weight: bold;
	}

	.cr-submit {
		flex-direction: row;
		margin-top: 20px;
	}

	.cr-warn {
		color: $vp-faint;
		font-size: 11px;
