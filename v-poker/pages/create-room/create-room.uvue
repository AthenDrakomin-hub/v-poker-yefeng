<template>
	<view class="vp-page cr-page">
		<view class="cr-statusbar" :style="statusBarStyle"></view>

		<view class="cr-topbar">
			<view class="cr-back" hover-class="cr-pressed" @click="goBack">
				<text class="cr-back-text">← 返回</text>
			</view>
			<view class="cr-brand">
				<text class="cr-brand-text">创建房间</text>
				<text class="cr-brand-sub">费率由平台统一配置</text>
			</view>
			<view class="cr-spacer"></view>
			<view class="cr-balance">
				<text class="cr-balance-text">筹码 {{ balanceText }}</text>
			</view>
		</view>

		<view class="cr-body">
			<view class="cr-col vp-card">
				<text class="cr-label">选择玩法</text>
				<view class="cr-games">
					<view v-for="g in games" :key="g.game_type" class="cr-game" :class="gameClass(g.game_type)"
						hover-class="cr-pressed" @click="selectGame(g.game_type)">
						<text class="cr-game-suit" :class="suitTextClass(g.game_type)">{{ g.icon }}</text>
						<text class="cr-game-name">{{ g.name }}</text>
					</view>
				</view>

				<text class="cr-label cr-label-gap">底分</text>
				<view class="cr-quicks">
					<view v-for="a in baseScores" :key="a" class="cr-quick" :class="quickClass(a)"
						hover-class="cr-pressed" @click="selectBase(a)">
						<text class="cr-quick-text" :class="quickTextClass(a)">{{ a }}</text>
					</view>
				</view>
				<vp-input v-model="baseText" type="number" placeholder="自定义底分" />
			</view>

			<view class="cr-col vp-card">
				<text class="cr-label">总局数</text>
				<vp-input v-model="roundsText" type="number" placeholder="默认 10" />

				<text class="cr-label cr-label-gap">人数上限</text>
				<vp-input v-model="maxPlayersText" type="number" placeholder="默认 6" />

				<text class="cr-label cr-label-gap">房间密码（选填）</text>
				<vp-input v-model="password" placeholder="不填为公开房" />

				<view class="cr-submit">
					<vp-button type="gold" size="lg" block :loading="submitting" text="创建房间" @click="submit" />
				</view>
				<text class="cr-warn">金额为整数筹码；创建后自动入座并进入牌桌</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'
	import { useWalletStore } from '@/store/wallet.uts'
	import { useLobbyStore } from '@/store/lobby.uts'
	import { GAME_ENTRIES, GameEntry, gameTypeRoute } from '@/utils/games.uts'
	import { formatAmount } from '@/utils/format.uts'

	const auth = useAuthStore()
	const wallet = useWalletStore()
	const lobby = useLobbyStore()

	const statusBarStyle = ref('height: 0px')
	const games = GAME_ENTRIES
	const baseScores: number[] = [100, 500, 1000, 5000]

	const selectedGame = ref('texas_holdem')
	const selectedBase = ref(100)
	const baseText = ref('')
	const roundsText = ref('10')
	const maxPlayersText = ref('6')
	const password = ref('')
	const submitting = ref(false)

	const balanceText = computed((): string => formatAmount(wallet.balance))

	onLoad(() => {
		const info = uni.getWindowInfo()
		statusBarStyle.value = `height: ${info.statusBarHeight}px`
	})

	onShow(() => {
		auth.restore()
		if (!auth.isLoggedIn) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		wallet.refreshBalance()
	})

	const gameClass = (gt: string): string => {
		return gt == selectedGame.value ? 'cr-game-active' : ''
	}

	const suitTextClass = (gt: string): string => {
		return gt == 'zha_jin_hua' || gt == 'san_gong' ? 'cr-suit-red' : 'cr-suit-black'
	}

	const quickClass = (a: number): string => {
		return a == selectedBase.value ? 'cr-quick-active' : ''
	}

	const quickTextClass = (a: number): string => {
		return a == selectedBase.value ? 'cr-quick-text-active' : 'cr-quick-text-normal'
	}

	const selectGame = (gt: string) => {
		selectedGame.value = gt
	}

	const selectBase = (a: number) => {
		selectedBase.value = a
		baseText.value = ''
	}

	const submit = async () => {
		if (submitting.value) {
			return
		}
		const custom = parseInt(baseText.value)
		const base = custom > 0 ? custom : selectedBase.value
		const rounds = parseInt(roundsText.value)
		const totalRounds = rounds > 0 ? rounds : 10
		const mp = parseInt(maxPlayersText.value)
		const maxPlayers = mp >= 2 && mp <= 9 ? mp : 6

		submitting.value = true
		try {
			const payload: UTSJSONObject = {
				room_name: `${auth.userId} 的${gameName(selectedGame.value)}房`,
				game_type: selectedGame.value,
				mode: 'cash',
				total_rounds: totalRounds,
				base_score: base,
				platform_fee_rate: 0.03,
				agent_commission_rate: 0.03,
				min_players: 2,
				max_players: maxPlayers,
				big_blind: base,
				rake_cap_multiplier: 5,
				room_password: password.value
			}
			const data = await lobby.createRoom(payload)
			if (data == null) {
				return
			}
			const rid = data.getString('room_id')
			if (rid == null) {
				return
			}
			const joined = await lobby.joinRoom(rid, password.value)
			if (joined != null) {
				uni.redirectTo({ url: `${gameTypeRoute(selectedGame.value)}?room_id=${rid}` })
			}
		} catch (e) {
			console.error('createRoom failed', e)
		} finally {
			submitting.value = false
		}
	}

	const gameName = (gt: string): string => {
		for (let i = 0; i < GAME_ENTRIES.length; i++) {
			if (GAME_ENTRIES[i].game_type == gt) {
				return GAME_ENTRIES[i].name
			}
		}
		return ''
	}

	const goBack = () => {
		uni.navigateBack()
	}
</script>

<style lang="scss">
	.cr-page {
		flex: 1;
		background-color: $vp-ink;
	}

	.cr-statusbar {
		width: 100%;
	}

	.cr-topbar {
		flex-direction: row;
		align-items: center;
