<template>
	<view class="sp-page">
		<!-- 高端俱乐部背景 -->
		<image class="sp-bg" src="/static/splash-bg.png" mode="aspectFill" />
		<view class="sp-bg-mask" />

		<view class="sp-body">
			<!-- 金色皇冠 Logo -->
			<image class="sp-logo animate-zoom-in" src="/static/logo-gold.png" mode="aspectFit" />

			<view class="sp-text-group animate-slide-up delay-200">
				<text class="sp-brand">V-POKER</text>
				<text class="sp-club">金 樽 俱 乐 部</text>
				<view class="sp-divider">
					<view class="sp-divider-line" />
					<text class="sp-divider-dot">♠</text>
					<view class="sp-divider-line" />
				</view>
				<text class="sp-slogan">一手牌 · 一世界</text>
			</view>

			<view class="sp-bar animate-fade-in delay-400">
				<view class="sp-bar-inner" :style="barStyle"></view>
			</view>
			<text class="sp-tip animate-pulse">{{ tip }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'

	const auth = useAuthStore()
	const tip = ref('正在进入金樽俱乐部…')
	const barStyle = ref('width: 10%;')

	onLoad(() => {
		let progress = 10
		const timer = setInterval(() => {
			progress += 20
			if (progress > 100) { progress = 100 }
			barStyle.value = `width: ${progress}%;`
			if (progress >= 100) {
				clearInterval(timer)
				auth.restore()
				tip.value = '欢迎光临'
				setTimeout(() => {
					uni.reLaunch({ url: auth.isLoggedIn ? '/pages/hall/hall' : '/pages/login/login' })
				}, 400)
			}
		}, 180)
	})
</script>

