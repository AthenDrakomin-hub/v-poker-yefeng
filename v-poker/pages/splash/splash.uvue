<template>
	<view class="sp-page">
		<image class="sp-bg" src="/static/bg/lobby-bg.png" mode="aspectFill" />
		<view class="sp-bg-mask" />

		<!-- 节日灯笼 -->
		<view class="sp-lantern sp-lantern-left">
			<view class="sp-lantern-rope" />
			<view class="sp-lantern-body">
				<text class="sp-lantern-fu">福</text>
			</view>
			<view class="sp-lantern-tassel" />
		</view>
		<view class="sp-lantern sp-lantern-right">
			<view class="sp-lantern-rope" />
			<view class="sp-lantern-body">
				<text class="sp-lantern-fu">春</text>
			</view>
			<view class="sp-lantern-tassel" />
		</view>

		<view class="sp-body">
			<!-- 品牌徽章 Logo：盾牌 + 黑桃 -->
			<view class="sp-badge">
				<text class="sp-badge-spade">♠</text>
			</view>
			<text class="sp-brand">V-POKER</text>
			<text class="sp-club">金 樽 俱 乐 部</text>
			<text class="sp-slogan">一手牌 · 一世界</text>

			<view class="sp-bar">
				<view class="sp-bar-inner" :style="barStyle"></view>
			</view>
			<text class="sp-tip">{{ tip }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { useAuthStore } from '@/store/auth.uts'

	const auth = useAuthStore()

	const tip = ref('正在启动…')
	const barStyle = ref('width: 10%;')

	onLoad(() => {
		let progress = 10
		const timer = setInterval(() => {
			progress += 20
			if (progress > 100) {
				progress = 100
			}
			barStyle.value = `width: ${progress}%;`
			if (progress >= 100) {
				clearInterval(timer)
				auth.restore()
				tip.value = '进入游戏…'
				setTimeout(() => {
					uni.reLaunch({ url: auth.isLoggedIn ? '/pages/hall/hall' : '/pages/login/login' })
				}, 300)
			}
		}, 180)
	})
</script>

