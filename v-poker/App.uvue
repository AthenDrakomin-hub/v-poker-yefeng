	 * ============================================================ */

	/* 页面根容器 — 简洁深色，不干扰核心内容 */
	.vp-page {
		flex-direction: column;
		background-color: #0d1117;
	}

	.vp-row {
		flex-direction: row;
	}

	.vp-col {
		flex-direction: column;
	}

	/* 文字 */
	.vp-text {
		color: $vp-text;
		font-size: 14px;
	}

	.vp-text-muted {
		color: $vp-muted;
		font-size: 13px;
	}

	.vp-text-gold {
		color: $vp-gold;
		font-size: 14px;
	}

	.vp-title {
		color: $vp-text;
		font-size: 18px;
		font-weight: bold;
	}

	/* 卡片 / 浮层 */
	.vp-card {
		background-color: $vp-surface;
		border-radius: $vp-radius-md;
		border-width: 1px;
		border-style: solid;
		border-color: $vp-border;
	}

	/* ========== 全局动画工具类 ========== */
	@keyframes vp-fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	@keyframes vp-slide-up {
		from { opacity: 0; transform: translateY(40rpx); }
		to { opacity: 1; transform: translateY(0); }
	}
	@keyframes vp-zoom-in {
		from { opacity: 0; transform: scale(0.9); }
		to { opacity: 1; transform: scale(1); }
	}
	@keyframes vp-pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.5; }
	}
	@keyframes vp-glow-pulse {
		0%, 100% { box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.3); }
		50% { box-shadow: 0 0 40rpx rgba(212, 175, 55, 0.6); }
	}
	@keyframes vp-spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.animate-fade-in { animation: vp-fade-in 300ms ease-out; }
	.animate-slide-up { animation: vp-slide-up 400ms ease-out; }
	.animate-zoom-in { animation: vp-zoom-in 300ms ease-out; }
	.animate-pulse { animation: vp-pulse 1.5s ease-in-out infinite; }
	.animate-glow { animation: vp-glow-pulse 2s ease-in-out infinite; }
	.animate-spin { animation: vp-spin 1s linear infinite; }

	.delay-100 { animation-delay: 100ms; }
	.delay-200 { animation-delay: 200ms; }
	.delay-300 { animation-delay: 300ms; }
	.delay-400 { animation-delay: 400ms; }
</style>
