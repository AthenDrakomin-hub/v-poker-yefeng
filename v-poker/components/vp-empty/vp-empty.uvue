<template>
	<view class="vpe">
		<view class="vpe-illustration">
			<view class="vpe-box"></view>
		</view>
		<text class="vpe-title">{{ title }}</text>
		<text v-if="description.length > 0" class="vpe-desc">{{ description }}</text>
		<view v-if="actionText.length > 0" class="vpe-action" hover-class="vpe-action-pressed" @click="onAction">
			<text class="vpe-action-text">{{ actionText }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * 空状态（迁移自源 PkEmpty）
	 */
	type VpEmptyProps = {
		title: string
		description: string
		actionText: string
	}

	const props = withDefaults(defineProps<VpEmptyProps>(), {
		title: '暂无数据',
		description: '',
		actionText: ''
	})

	const emit = defineEmits(['action'])

	const onAction = () => {
		emit('action')
	}
</script>

