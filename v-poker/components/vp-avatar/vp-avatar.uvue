<template>
	<view class="vpa" :style="boxStyle">
		<image v-if="src.length > 0" class="vpa-img" :src="src" mode="aspectFill" />
		<view v-else class="vpa-fallback">
			<text class="vpa-initial">{{ initial }}</text>
		</view>
		<view v-if="showVip" class="vpa-vip">
			<text class="vpa-vip-text">VIP{{ vip }}</text>
		</view>
		<view v-if="online" class="vpa-online"></view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'

	/**
	 * 头像（迁移自源 PkAvatar）
	 */
	type VpAvatarProps = {
		src: string
		name: string
		/** 直径，px */
		size: number
		/** 非空且非 "0" 时显示 VIP 角标 */
		vip: string
		online: boolean
	}

	const props = withDefaults(defineProps<VpAvatarProps>(), {
		src: '',
		name: '',
		size: 48,
		vip: '',
		online: false
	})

	const initial = computed((): string => {
		if (props.name.length == 0) {
			return '?'
		}
		return props.name.substring(0, 1).toUpperCase()
	})

	const boxStyle = computed((): string => {
		return `width:${props.size}px;height:${props.size}px;`
	})

	const showVip = computed((): boolean => {
		return props.vip.length > 0 && props.vip != '0'
	})
</script>

<style lang="scss">
	.vpa {
		position: relative;
		border-radius: 50%;
		border-width: 2px;
		border-style: solid;
		border-color: $vp-gold;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.vpa-img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
	}

	.vpa-fallback {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background-color: #2e3d5e;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.vpa-initial {
		color: #ffffff;
		font-size: 16px;
		font-weight: bold;
	}

	.vpa-vip {
		position: absolute;
		bottom: -4px;
		left: 50%;
		margin-left: -24px;
		width: 48px;
		background-color: #c9a961;
		border-radius: 999px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.vpa-vip-text {
		font-size: 8px;
		color: #4a3000;
		font-weight: bold;
	}

	.vpa-online {
		position: absolute;
		top: 2px;
		right: 2px;
		width: 8px;
		height: 8px;
		background-color: #2ecc71;
		border-width: 1px;
		border-style: solid;
		border-color: #ffffff;
		border-radius: 50%;
	}
</style>
