<template>
	<view class="vpt">
		<!-- 写实桌布底图 -->
		<image class="vpt-desk-bg" src="/static/table/classic-desk.png" mode="aspectFit" />

		<!-- 荷官角色（桌中央上方） -->
		<image class="vpt-dealer" src="/static/avatar/dealer.png" mode="aspectFit" />

		<!-- 浮层：阶段 + 底池 + 公共牌 -->
		<view class="vpt-overlay">
			<text class="vpt-phase">{{ phase_text }}</text>

			<view class="vpt-pot">
				<vp-chip-stack v-if="pot > 0" :amount="pot_text" color="gold" :size="36" :layers="4" />
				<text class="vpt-pot-label">底池</text>
				<text class="vpt-pot-value">{{ pot_text }}</text>
			</view>

			<!-- 边池 (all-in 拆分) -->
			<view v-if="side_pots.length > 0" class="vpt-side-pots">
				<text v-for="(sp, i) in side_pots" :key="i" class="vpt-side-pot">
					边池{{ i + 1 }}: {{ formatAmount(sp) }}
				</text>
			</view>

			<view class="vpt-community">
				<vp-card v-for="(c, i) in community_codes" :key="i" :code="c" :face_down="false" size="md" />
				<view v-for="(item, j) in empty_slots" :key="'e' + j" class="vpt-slot" />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { formatAmount } from '@/utils/format.uts'

	/**
	 * 牌桌：写实桌布图 + 荷官 + 浮层（底池/公共牌/阶段）
	 * 座位由页面绝对定位覆盖
	 */
	type VpPokerTableProps = {
		pot: number
		community_codes: string[]
		phase: string
		side_pots: number[]
	}

	const props = defineProps<VpPokerTableProps>()

	const pot_text = computed((): string => {
		return formatAmount(props.pot)
	})

	const empty_slots = computed((): number[] => {
		const out: number[] = []
		const remain = 5 - props.community_codes.length
		for (let i = 0; i < remain; i++) {
			out.push(i)
		}
		return out
	})

	const phase_text = computed((): string => {
		const p = props.phase
		if (p == 'WAITING') {
			return '等待开始'
		}
		if (p == 'DEALING') {
			return '发牌中'
		}
		if (p == 'BETTING') {
			return '下注中'
		}
		if (p == 'SHOWDOWN') {
			return '比牌'
		}
		if (p == 'SETTLING') {
			return '结算中'
		}
		if (p == 'FINISHED') {
			return '本局结束'
		}
		return p
	})
</script>

<style lang="scss">
	.vpt {
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	/* 写实桌布图 */
	.vpt-desk-bg {
		position: absolute;
		width: 100%;
		height: 100%;
	}

	/* 荷官角色：桌中央偏上 */
	.vpt-dealer {
		width: 72px;
		height: 96px;
		margin-bottom: -30px;
		z-index: 2;
	}

	/* 浮层：覆盖在桌布上 */
	.vpt-overlay {
		flex-direction: column;
		align-items: center;
		justify-content: center;
		z-index: 1;
		margin-top: -10px;
	}

	.vpt-phase {
		color: rgba(255, 255, 255, 0.7);
		font-size: 11px;
		letter-spacing: 2px;
		margin-bottom: 8px;
	}

	.vpt-pot {
		flex-direction: column;
		align-items: center;
		margin-bottom: 10px;
	}

	.vpt-pot-label {
		color: rgba(255, 255, 255, 0.75);
		font-size: 11px;
		letter-spacing: 1px;
	}

	.vpt-pot-value {
		color: #e6c85a;
		font-size: 22px;
		font-weight: bold;
		margin-top: 2px;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
	}

	.vpt-side-pots {
		flex-direction: row;
		margin-top: 4px;
	}

	.vpt-side-pot {
		color: rgba(255, 255, 255, 0.6);
		font-size: 10px;
		margin: 0 6px;
	}

	.vpt-community {
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.vpt-slot {
		width: 44px;
		height: 62px;
		background-color: rgba(0, 0, 0, 0.22);
		border-radius: 6px;
		border-width: 1px;
		border-style: dashed;
		border-color: rgba(255, 255, 255, 0.3);
		margin-left: 4px;
		margin-right: 4px;
	}
</style>
