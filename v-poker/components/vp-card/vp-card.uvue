<template>
	<view class="vpc" :class="root_class">
		<!-- 背面：PNG 牌背 -->
		<image v-if="show_back" class="vpc-img" src="/static/cards/CardBack.png" mode="aspectFit" />
		<!-- 正面：PNG 牌面 -->
		<image v-else class="vpc-img" :src="cardImage" mode="aspectFit" />
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'

	/**
	 * 扑克牌
	 * code 格式："{suit}-{rank}"，如 "S-1"、"H-11"；空 code 或 face_down 时显示背面
	 * 素材映射：S→3(黑桃), H→2(红桃), D→1(方块), C→0(梅花); rank 1(A)→14
	 */
	type VpCardProps = {
		code: string
		face_down: boolean
		size: string
	}

	const props = defineProps<VpCardProps>()

	const show_back = computed((): boolean => {
		return props.face_down || props.code.length == 0
	})

	/** code "S-1" -> "/static/cards/3_14.png" */
	const cardImage = computed((): string => {
		if (props.code.length == 0) {
			return '/static/cards/CardBack.png'
		}
		const parts = props.code.split('-')
		if (parts.length < 2) {
			return '/static/cards/CardBack.png'
		}
		const suitChar = parts[0]
		const rankStr = parts[1]

		// 花色映射
		let suitIdx = 0
		if (suitChar == 'S') {
			suitIdx = 3
		} else if (suitChar == 'H') {
			suitIdx = 2
		} else if (suitChar == 'D') {
			suitIdx = 1
		} else if (suitChar == 'C') {
			suitIdx = 0
		}

		// rank 映射：1(A)→14
		let rankNum = parseInt(rankStr)
		if (rankNum == 1) {
			rankNum = 14
		}

		return `/static/cards/${suitIdx}_${rankNum}.png`
	})

	const root_class = computed((): string => {
		return props.size == 'sm' ? 'vpc-sm' : 'vpc-md'
	})
</script>

<style lang="scss">
	.vpc {
		flex-direction: column;
	}

	.vpc-sm {
		width: 32px;
		height: 45px;
	}

	.vpc-md {
		width: 44px;
		height: 62px;
	}

	.vpc-img {
		width: 100%;
		height: 100%;
		border-radius: 4px;
	}
</style>
