<template>
	<view class="vpc" :class="root_class">
		<!-- 背面：CSS矢量图案 -->
		<view v-if="show_back" class="vpc-back">
			<view class="vpc-back-pattern" />
			<view class="vpc-back-border" />
		</view>
		<!-- 正面：CSS矢量绘制 -->
		<view v-else class="vpc-front">
			<view class="vpc-corner" :class="is_red ? 'vpc-red' : 'vpc-black'">
				<text class="vpc-rank">{{ rank_label }}</text>
				<text class="vpc-suit-sm">{{ suit_symbol }}</text>
			</view>
			<text class="vpc-suit-lg" :class="is_red ? 'vpc-red' : 'vpc-black'">{{ suit_symbol }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'

	/**
	 * 扑克牌 — CSS矢量绘制，无限清晰无锯齿
	 * code 格式："{suit}-{rank}"，如 "S-1"、"H-11"；空 code 或 face_down 时显示背面
	 */
	type VpCardProps = {
		code: string
		face_down: boolean
		size: string
	}

	const props = defineProps<VpCardProps>()

	const show_back = computed((): boolean => {
		return props.face_down || props.code.length == 0
	})

	const suit_char = computed((): string => {
		const parts = props.code.split('-')
		return parts.length >= 2 ? parts[0] : 'S'
	})

	const rank_num = computed((): number => {
		const parts = props.code.split('-')
		return parts.length >= 2 ? parseInt(parts[1]) : 1
	})

	const suit_symbol = computed((): string => {
		if (suit_char.value == 'S') return '♠'
		if (suit_char.value == 'H') return '♥'
		if (suit_char.value == 'D') return '♦'
		if (suit_char.value == 'C') return '♣'
		return '♠'
	})

	const rank_label = computed((): string => {
		const r = rank_num.value
		if (r == 1 || r == 14) return 'A'
		if (r == 11) return 'J'
		if (r == 12) return 'Q'
		if (r == 13) return 'K'
		return String(r)
	})

	const is_red = computed((): boolean => {
		return suit_char.value == 'H' || suit_char.value == 'D'
	})

	const root_class = computed((): string => {
		return props.size == 'sm' ? 'vpc-sm' : 'vpc-md'
	})
</script>

<style lang="scss">
	.vpc {
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.vpc-sm {
		width: 34px;
		height: 48px;
	}

	.vpc-md {
		width: 48px;
		height: 68px;
	}

	/* 牌背：磨砂纹理+金色细边框 */
	.vpc-back {
		width: 100%;
		height: 100%;
		border-radius: 4px;
		background: linear-gradient(135deg, #1e3a5f 0%, #0f1f3a 50%, #1e3a5f 100%);
		overflow: hidden;
		position: relative;
		border-width: 1px;
		border-style: solid;
		border-color: #c9a84c;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
	}

	.vpc-back-pattern {
		position: absolute;
		width: 200%;
		height: 200%;
		background: repeating-linear-gradient(
			45deg,
			transparent 0px,
			transparent 3px,
			rgba(255, 255, 255, 0.03) 3px,
			rgba(255, 255, 255, 0.03) 6px
		);
	}

	.vpc-back-border {
		position: absolute;
		left: 2px;
		top: 2px;
		right: 2px;
		bottom: 2px;
		border-radius: 2px;
		border-width: 1px;
		border-style: solid;
		border-color: rgba(201, 168, 76, 0.4);
	}

	/* 牌面：CSS矢量 — 1:1.4桥牌比例，立体感阴影 */
	.vpc-front {
		width: 100%;
		height: 100%;
		background-color: #ffffff;
		border-radius: 4px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		position: relative;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35), 0 1px 2px rgba(0, 0, 0, 0.2);
	}

	.vpc-corner {
		position: absolute;
		left: 3px;
		top: 2px;
		flex-direction: column;
		align-items: center;
	}

	.vpc-rank {
		font-size: 11px;
		font-weight: bold;
		line-height: 11px;
	}

	.vpc-suit-sm {
		font-size: 10px;
		line-height: 10px;
		margin-top: 1px;
	}

	.vpc-suit-lg {
		font-size: 22px;
	}

	.vpc-red {
		color: #d42b2b;
	}

	.vpc-black {
		color: #1a1a1a;
	}
</style>
