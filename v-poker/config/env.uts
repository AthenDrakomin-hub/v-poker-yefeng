/**
 * 全局环境配置
 * 契约（FRONTEND_CONTRACT.md 第一章）：
 *  - HTTP 全走 BFF（禁止直连微服务），baseURL 指向 BFF
 *  - WebSocket 直连 game-engine /ws
 *  - 金额整数、时间 Unix 毫秒、ID 字符串
 *
 * 开发联调：
 *  - H5 / 浏览器：BFF http://localhost:4000，WS ws://localhost:8003/ws
 *  - App 真机：localhost 指向手机自身，需改成开发电脑局域网 IP（后端需监听 0.0.0.0）
 * 生产：https://goodspage.cn（nginx 反代 /api 与 /ws）
 */

// 开发机局域网 IP：App 真机联调时改成开发电脑的 IP
const DEV_HOST = '192.168.1.10'

// #ifdef H5
export const BFF_BASE_URL: string = 'http://localhost:4000'
export const WS_URL: string = 'ws://localhost:8003/ws'
// #endif

// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
export const BFF_BASE_URL: string = `http://${DEV_HOST}:4000`
export const WS_URL: string = `ws://${DEV_HOST}:8003/ws`
// #endif

// #ifdef MP-WEIXIN
export const BFF_BASE_URL: string = 'https://goodspage.cn'
export const WS_URL: string = 'wss://goodspage.cn/ws'
// #endif

/** HTTP 请求超时 */
export const REQUEST_TIMEOUT_MS: number = 15000

/** WS 心跳间隔（发 ping） */
export const HEARTBEAT_INTERVAL_MS: number = 30000
/** WS pong 超时（超时主动断开） */
export const PONG_TIMEOUT_MS: number = 60000
/** action_ack 等待超时（禁止省略，超时降级） */
export const ACK_TIMEOUT_MS: number = 5000
/** join_room 等待超时 */
export const JOIN_TIMEOUT_MS: number = 5000
/** 最大重连次数 */
export const MAX_RECONNECT: number = 5
/** 重连基础退避（1s → 2s → 4s → 8s → 16s → 30s） */
export const RECONNECT_BASE_MS: number = 1000
/** 重连退避上限 */
export const RECONNECT_MAX_MS: number = 30000

/** 本地存储 key */
export const TOKEN_KEY: string = 'poker_jwt_token'
export const USER_ID_KEY: string = 'poker_user_id'
export const USER_ROLE_KEY: string = 'poker_user_role'
export const USER_NAME_KEY: string = 'poker_user_name'
