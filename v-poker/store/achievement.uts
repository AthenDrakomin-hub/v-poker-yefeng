/**
 * 成就 Store
 */

import { ref } from 'vue'
import { defineStore } from 'pinia'
import { listAchievements } from '@/utils/http/api/achievement.uts'
import { useAuthStore } from './auth.uts'

export type AchievementEntry = {
	id: string
	name: string
	desc: string
	icon: string
	unlocked: boolean
	unlockedAt: number
}

export const useAchievementStore = defineStore('achievement', () => {
	const list = ref<AchievementEntry[]>([])
	const loading = ref(false)
	const errorMessage = ref('')

	const loadAchievements = async () => {
		const auth = useAuthStore()
		if (auth.userId.length == 0) return
		loading.value = true
		errorMessage.value = ''
		try {
			const raw = await listAchievements(auth.userId)
			const entries: AchievementEntry[] = []
			for (let i = 0; i < raw.length; i++) {
				const id = raw[i].getString('id')
				const name = raw[i].getString('name')
				const desc = raw[i].getString('desc')
				const icon = raw[i].getString('icon')
				const unlocked = raw[i].getBoolean('unlocked')
				const unlockedAt = raw[i].getNumber('unlocked_at')
				entries.push({
					id: id == null ? '' : id,
					name: name == null ? '' : '',
					desc: desc == null ? '' : '',
					icon: icon == null ? '♠' : icon,
					unlocked: unlocked == null ? false : unlocked,
					unlockedAt: unlockedAt == null ? 0 : unlockedAt
				})
			}
			list.value = entries
		} catch (e) {
			errorMessage.value = '成就加载失败'
			console.error('loadAchievements failed', e)
		} finally {
			loading.value = false
		}
	}

	return { list, loading, errorMessage, loadAchievements }
})
