# V-POKER 测试环境配置
# 数据库使用独立的测试数据库，避免污染生产数据

# ========== 环境标识 ==========
ENV=test
APP_NAME=V-POKER-Test
VERSION=1.0.0

# ========== PostgreSQL 数据库 ==========
# 测试数据库（独立的数据库名）
POSTGRES_USER=poker_admin
POSTGRES_PASSWORD=PokerDB2024
POSTGRES_DB=poker_platform_test
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 异步数据库连接字符串（Python 服务使用）
DATABASE_URL=postgresql+asyncpg://poker_admin:PokerDB2024@postgres:5432/poker_platform_test

# 同步数据库连接字符串（BFF 使用）
DATABASE_URL_SYNC=postgresql://poker_admin:PokerDB2024@postgres:5432/poker_platform_test

# ========== JWT 认证 ==========
JWT_SECRET=TestJwtSecret2024!ForTestingOnly!
JWT_EXPIRE_HOURS=168

# ========== 服务端口 ==========
# 测试环境端口不同，避免和生产冲突
WALLET_SERVICE_PORT=8011
COMMISSION_SERVICE_PORT=8010
BFF_PORT=4010
GAME_ENGINE_PORT=8013

# ========== 游戏配置 ==========
PLATFORM_FEE_RATE=0.0300
AGENT_COMMISSION_RATE=0.0300
DISCONNECT_TIMEOUT_MS=300000

# ========== 其他服务地址 ==========
COMMISSION_SERVICE_URL=http://commission-service:8000
WALLET_SERVICE_URL=http://wallet-service:8001
GAME_ENGINE_URL=http://game-engine:8003

# ========== CORS 配置 ==========
CORS_ALLOWED_ORIGINS=https://test.goodspage.cn,http://localhost:3000

# ========== 调试模式 ==========
DEBUG=true
