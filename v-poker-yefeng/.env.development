# V-POKER 开发环境配置
# 使用 SQLite 数据库，无需 PostgreSQL

# ========== 环境标识 ==========
ENV=development
APP_NAME=V-POKER-Dev
VERSION=1.0.0-dev

# ========== 数据库配置 ==========
# 开发环境使用 SQLite，无需 PostgreSQL
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=poker_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLite 数据库连接
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_URL_SYNC=sqlite:///./dev.db

# ========== JWT 认证 ==========
JWT_SECRET=DevJwtSecret!ForLocalDevelopmentOnly!
JWT_EXPIRE_HOURS=168

# ========== 服务端口 ==========
WALLET_SERVICE_PORT=8001
COMMISSION_SERVICE_PORT=8000
BFF_PORT=4000
GAME_ENGINE_PORT=8003

# ========== 游戏配置 ==========
PLATFORM_FEE_RATE=0.0300
AGENT_COMMISSION_RATE=0.0300
DISCONNECT_TIMEOUT_MS=300000

# ========== 其他服务地址 ==========
COMMISSION_SERVICE_URL=http://localhost:8000
WALLET_SERVICE_URL=http://localhost:8001
GAME_ENGINE_URL=http://localhost:8003

# ========== CORS 配置 ==========
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== 调试模式 ==========
DEBUG=true
