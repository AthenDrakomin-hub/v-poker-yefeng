/**
 * V-POKER API服务层
 * 对接BFF: http://127.0.0.1:4000
 */
const BFF_URL = "http://127.0.0.1:4000";
const ENGINE_URL = "http://127.0.0.1:8003";

function getToken(): string {
  return uni.getStorageSync("token") as string || "";
}

async function request(path: string, method: string = "GET", data: object | null = null): Promise<any> {
  return new Promise((resolve, reject) => {
    uni.request({
      url: BFF_URL + path,
      method: method as any,
      data: data || {},
      header: {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + getToken(),
      },
      success: (res) => {
        if (res.statusCode === 401) {
          uni.removeStorageSync("token");
          uni.reLaunch({ url: "/pages/login/login" });
          reject(new Error("未登录"));
          return;
        }
        resolve(res.data);
      },
      fail: (err) => reject(new Error(err.errMsg)),
    });
  });
}

export const api = {
  // 认证
  login(username: string, password: string): Promise<any> {
    return request("/api/auth/login", "POST", { username, password });
  },
  register(username: string, password: string): Promise<any> {
    return request("/api/auth/register", "POST", { username, password });
  },

  // 房间
  listRooms(gameType: string = ""): Promise<any> {
    return request("/api/rooms/list" + (gameType ? "?game_type=" + gameType : ""));
  },
  createRoom(gameType: string, mode: string, baseScore: number): Promise<any> {
    return request("/api/rooms/create", "POST", { game_type: gameType, mode, base_score: baseScore });
  },
  joinRoom(roomId: string): Promise<any> {
    return request("/api/rooms/join", "POST", { room_id: roomId });
  },

  // 钱包
  balance(userId: string): Promise<any> {
    return request("/api/wallet/balance/" + userId);
  },
  transactions(userId: string, limit: number = 50): Promise<any> {
    return request("/api/wallet/transactions?user_id=" + userId + "&limit=" + limit);
  },
  leaderboard(limit: number = 20): Promise<any> {
    return request("/api/wallet/leaderboard?limit=" + limit);
  },
};

export const engineApi = {
  getRoom(roomId: string): Promise<any> {
    return new Promise((resolve, reject) => {
      uni.request({
        url: ENGINE_URL + "/api/engine/room/" + roomId,
        method: "GET",
        header: { "Authorization": "Bearer " + getToken() },
        success: (res) => resolve(res.data),
        fail: (err) => reject(new Error(err.errMsg)),
      });
    });
  },
  sendAction(roomId: string, action: object): Promise<any> {
    return new Promise((resolve, reject) => {
      uni.request({
        url: ENGINE_URL + "/api/engine/room/" + roomId + "/action",
        method: "POST",
        data: action,
        header: {
          "Content-Type": "application/json",
          "Authorization": "Bearer " + getToken(),
        },
        success: (res) => resolve(res.data),
        fail: (err) => reject(new Error(err.errMsg)),
      });
    });
  },
};
