/**
 * V-POKER WebSocket服务
 * 连接游戏引擎WS，接收房间状态推送
 */
const ENGINE_WS = "ws://127.0.0.1:8003/ws";

type StateCallback = (state: object) => void;
type NotificationCallback = (msg: object) => void;

class GameWS {
  private socketTask: UniApp.SocketTask | null = null;
  private roomId: string = "";
  private userId: string = "";
  private onStateCb: StateCallback | null = null;
  private onNotifCb: NotificationCallback | null = null;
  private reconnectTimer: any = null;

  connect(roomId: string, userId: string, onState: StateCallback, onNotif: NotificationCallback) {
    this.roomId = roomId;
    this.userId = userId;
    this.onStateCb = onState;
    this.onNotifCb = onNotif;

    const token = uni.getStorageSync("token") as string || "";
    this.socketTask = uni.connectSocket({
      url: ENGINE_WS + "?token=" + token,
      success: () => console.log("WS connecting..."),
    });

    this.socketTask.onOpen(() => {
      console.log("WS connected");
      this.send({ type: "join_room", room_id: roomId, user_id: userId });
    });

    this.socketTask.onMessage((res) => {
      try {
        const msg = JSON.parse(res.data as string);
        if (msg.type === "room_state" && this.onStateCb) {
          this.onStateCb(msg.data);
        } else if (this.onNotifCb) {
          this.onNotifCb(msg);
        }
      } catch (e) {
        console.error("WS parse error", e);
      }
    });

    this.socketTask.onClose(() => {
      console.log("WS closed, reconnect in 3s");
      this.reconnectTimer = setTimeout(() => {
        this.connect(roomId, userId, onState, onNotif);
      }, 3000);
    });

    this.socketTask.onError((err) => {
      console.error("WS error", err);
    });
  }

  send(data: object) {
    if (this.socketTask) {
      this.socketTask.send({ data: JSON.stringify(data) });
    }
  }

  sendAction(actionType: string, amount: number = 0, cards: object[] = []) {
    this.send({
      type: "player_action",
      user_id: this.userId,
      action: {
        action_type: actionType,
        user_id: this.userId,
        amount,
        cards,
      },
    });
  }

  disconnect() {
    if (this.reconnectTimer) clearTimeout(this.reconnectTimer);
    if (this.socketTask) {
      this.socketTask.close({});
      this.socketTask = null;
    }
  }
}

export const gameWS = new GameWS();
