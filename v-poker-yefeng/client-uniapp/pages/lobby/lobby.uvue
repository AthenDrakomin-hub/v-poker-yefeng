<template>
  <view class="container" flatten="true">
    <view class="header">
      <text class="title">V-POKER 大厅</text>
      <view class="wallet" @tap="goWallet">
        <text class="balance">💰 {{ balance }}</text>
      </view>
    </view>

    <scroll-view class="game-list" scroll-y="true">
      <view
        v-for="game in games"
        :key="game.id"
        class="game-card"
        @tap="createAndJoin(game.id)"
      >
        <view class="game-icon">{{ game.icon }}</view>
        <view class="game-info">
          <text class="game-name">{{ game.name }}</text>
          <text class="game-desc">{{ game.desc }}</text>
        </view>
        <text class="game-arrow">›</text>
      </view>
    </scroll-view>

    <view class="bottom-bar">
      <button class="vp-btn vp-btn-ghost" @tap="refreshRooms">刷新</button>
      <button class="vp-btn vp-btn-danger" @tap="logout">退出</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from "vue";
import { api } from "../../common/api.uts";

const balance = ref("10,000");
const userId = uni.getStorageSync("userId") as string || "";

const games = ref([
  { id: "texas_holdem", name: "德州扑克", icon: "♠", desc: "2底牌 5公共牌" },
  { id: "zha_jin_hua", name: "炸金花", icon: "🃏", desc: "3张比大小" },
  { id: "niu_niu", name: "牛牛", icon: "🐂", desc: "5张抢庄" },
  { id: "doudizhu", name: "斗地主", icon: "🎴", desc: "3人出牌" },
  { id: "omaha", name: "奥马哈", icon: "♦", desc: "4底牌" },
  { id: "san_gong", name: "三公", icon: "🎲", desc: "3张比点数" },
  { id: "guandan", name: "掼蛋", icon: "🃋", desc: "4人组队两副牌" },
  { id: "short_deck", name: "短牌德州", icon: "♣", desc: "36张快节奏" },
]);

onMounted(async () => {
  await refreshBalance();
});

async function refreshBalance() {
  try {
    const res = await api.balance(userId);
    if (res.code === 0) balance.value = Number(res.data.balance).toLocaleString();
  } catch (e) {}
}

async function createAndJoin(gameType: string) {
  uni.showLoading({ title: "创建房间..." });
  try {
    // 创建房间
    const createRes = await api.createRoom(gameType, "fixed_limit", 100);
    if (createRes.code !== 0) throw new Error(createRes.message);
    const roomId = createRes.data.room_id;

    // 加入房间
    await api.joinRoom(roomId);
    uni.hideLoading();
    uni.navigateTo({ url: "/pages/table/table?roomId=" + roomId + "&gameType=" + gameType });
  } catch (e: any) {
    uni.hideLoading();
    uni.showToast({ title: "建房失败: " + e.message, icon: "none" });
  }
}

function refreshRooms() {
  refreshBalance();
  uni.showToast({ title: "已刷新", icon: "success" });
}

function goWallet() {
  uni.navigateTo({ url: "/pages/wallet/wallet" });
}

function logout() {
  uni.removeStorageSync("token");
  uni.removeStorageSync("userId");
  uni.reLaunch({ url: "/pages/login/login" });
}
</script>

<style>
.container {
  flex: 1;
  background-color: #0d1f15;
}
.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: #1a3a2a;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #c9a84c;
}
.balance {
  font-size: 28rpx;
  color: #ffffff;
}
.game-list {
  flex: 1;
  padding: 20rpx;
}
.game-card {
  flex-direction: row;
  align-items: center;
  background-color: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.game-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  width: 60rpx;
  text-align: center;
}
.game-info {
  flex: 1;
}
.game-name {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}
.game-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 8rpx;
}
.game-arrow {
  font-size: 40rpx;
  color: rgba(255,255,255,0.3);
}
.bottom-bar {
  flex-direction: row;
  justify-content: center;
  gap: 20rpx;
  padding: 20rpx;
  padding-bottom: 40rpx;
}
</style>
