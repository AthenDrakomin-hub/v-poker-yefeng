.container {
  flex: 1;
  background-color: #0d1f15;
  padding: 20rpx;
}
.balance-card {
  background: linear-gradient(135deg, #c9a84c 0%, #8a6d2f 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  align-items: center;
  margin-bottom: 30rpx;
}
.balance-label {
  font-size: 26rpx;
  color: rgba(0,0,0,0.7);
}
.balance-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #000000;
  margin-top: 10rpx;
}
.section {
  flex: 1;
}
.section-title {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.tx-list {
  flex: 1;
}
.tx-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background-color: rgba(255,255,255,0.05);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.tx-left {
  flex: 1;
}
.tx-type {
  font-size: 28rpx;
  color: #ffffff;
}
.tx-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  margin-top: 6rpx;
}
.tx-amount {
  font-size: 30rpx;
  font-weight: bold;
}
.positive {
  color: #4caf50;
}
.negative {
  color: #f44336;
}
.empty {
  align-items: center;
  padding: 60rpx;
}
.empty text {
  color: rgba(255,255,255,0.3);
}
</style>
