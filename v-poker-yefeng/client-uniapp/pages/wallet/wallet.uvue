<template>
  <view class="container" flatten="true">
    <view class="balance-card">
      <text class="balance-label">我的余额</text>
      <text class="balance-value">💰 {{ balance }}</text>
    </view>

    <view class="section">
      <text class="section-title">交易记录</text>
      <scroll-view scroll-y="true" class="tx-list">
        <view v-for="(tx, i) in transactions" :key="i" class="tx-item">
          <view class="tx-left">
            <text class="tx-type">{{ tx.type }}</text>
            <text class="tx-time">{{ tx.created_at }}</text>
          </view>
          <text class="tx-amount" :class="{ positive: tx.amount > 0, negative: tx.amount < 0 }">
            {{ tx.amount > 0 ? "+" : "" }}{{ tx.amount }}
          </text>
        </view>
        <view v-if="transactions.length === 0" class="empty">
          <text>暂无记录</text>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from "vue";
import { api } from "../../common/api.uts";

const balance = ref("0");
const transactions = ref<any[]>([]);
const userId = uni.getStorageSync("userId") as string || "";

onMounted(async () => {
  await loadData();
});

async function loadData() {
  try {
    const balRes = await api.balance(userId);
    if (balRes.code === 0) {
      balance.value = Number(balRes.data.balance).toLocaleString();
    }
    const txRes = await api.transactions(userId, 20);
    if (txRes.code === 0) {
      transactions.value = txRes.data || [];
    }
  } catch (e) {
    uni.showToast({ title: "加载失败", icon: "none" });
  }
}
</script>

