<template>
  <view class="container" flatten="true">
    <view class="logo">
      <text class="logo-text">V-POKER</text>
      <text class="logo-sub">棋牌游戏平台</text>
    </view>

    <view class="form">
      <input class="input" v-model="username" placeholder="用户名" placeholder-class="ph" />
      <input class="input" v-model="password" password placeholder="密码" placeholder-class="ph" />

      <button class="vp-btn vp-btn-primary login-btn" @tap="handleLogin" :disabled="loading">
        {{ loading ? "登录中..." : "登 录" }}
      </button>

      <view class="register-link" @tap="goRegister">
        <text>没有账号？立即注册</text>
      </view>
    </view>

    <view class="demo-tip">
      <text class="tip-text">测试账号: admin_root / test</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from "vue";
import { api } from "../../common/api.uts";

const username = ref("");
const password = ref("");
const loading = ref(false);

async function handleLogin() {
  if (!username.value || !password.value) {
    uni.showToast({ title: "请输入用户名和密码", icon: "none" });
    return;
  }
  loading.value = true;
  try {
    const res = await api.login(username.value, password.value);
    if (res.code === 0) {
      uni.setStorageSync("token", res.data.access_token);
      uni.setStorageSync("userId", res.data.user_id);
      uni.showToast({ title: "登录成功", icon: "success" });
      setTimeout(() => {
        uni.reLaunch({ url: "/pages/lobby/lobby" });
      }, 500);
    } else {
      uni.showToast({ title: res.message || "登录失败", icon: "none" });
    }
  } catch (e: any) {
    uni.showToast({ title: "网络错误", icon: "none" });
  } finally {
    loading.value = false;
  }
}

function goRegister() {
  uni.showToast({ title: "请使用测试账号登录", icon: "none" });
}
</script>

<style>
.container {
  flex: 1;
  background: linear-gradient(180deg, #1a3a2a 0%, #0d1f15 100%);
  justify-content: center;
  padding: 60rpx;
}
.logo {
  align-items: center;
  margin-bottom: 80rpx;
}
.logo-text {
  font-size: 72rpx;
  font-weight: bold;
  color: #c9a84c;
  letter-spacing: 8rpx;
}
.logo-sub {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 12rpx;
}
.form {
  width: 100%;
}
.input {
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  font-size: 30rpx;
}
.ph {
  color: rgba(255,255,255,0.4);
}
.login-btn {
  margin-top: 20rpx;
  padding: 24rpx;
}
.register-link {
  text-align: center;
  margin-top: 30rpx;
}
.register-link text {
  color: #c9a84c;
  font-size: 26rpx;
}
.demo-tip {
  margin-top: 60rpx;
  align-items: center;
}
.tip-text {
  color: rgba(255,255,255,0.3);
  font-size: 22rpx;
}
</style>
