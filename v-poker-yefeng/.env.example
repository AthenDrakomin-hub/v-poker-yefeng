# ============================================================
# V-POKER 环境变量模板 (.env.example)
# 复制为 .env 并填入真实值
# ============================================================

# ========== 环境标识 ==========
ENV=production
APP_NAME=V-POKER
VERSION=1.0.0

# ========== PostgreSQL 数据库 ==========
POSTGRES_USER=poker_admin
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_PASSWORD__
POSTGRES_DB=poker_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 应用使用的连接字符串（game-engine 用）
DATABASE_URL=postgresql://poker_admin:__CHANGE_ME_STRONG_PASSWORD__@localhost:5432/poker_platform

# ========== 内部服务鉴权（必须修改！） ==========
# game-engine HTTP API 校验此 header
INTERNAL_AUTH_KEY=__CHANGE_ME_RANDOM_32_CHARS__

# wallet_service 铸币接口校验此 header
WALLET_INTERNAL_KEY=__CHANGE_ME_RANDOM_32_CHARS__

# ========== JWT 认证 ==========
JWT_SECRET=__CHANGE_ME_LONG_RANDOM_STRING__
JWT_EXPIRE_HOURS=168

# ========== 服务端口 ==========
WALLET_SERVICE_PORT=8001
COMMISSION_SERVICE_PORT=8000
BFF_PORT=4000
GAME_ENGINE_PORT=8003
ADMIN_DASHBOARD_PORT=8088
METABASE_PORT=3030

# ========== 服务间通信 URL ==========
# BFF 调用 wallet_service
WALLET_SERVICE_URL=http://wallet-service:8001
# BFF 调用 commission_service
COMMISSION_SERVICE_URL=http://commission-service:8000
# BFF 转发到 game-engine
GAME_ENGINE_URL=http://game-engine:8003

# ========== CORS 白名单 ==========
# 逗号分隔，只允许这些域名访问 API
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# ========== game-engine 配置 ==========
# 回合超时（毫秒）
TURN_TIMEOUT_MS=30000
# 断线超时（毫秒），超时自动弃牌
DISCONNECT_TIMEOUT_MS=300000

# ========== 前端配置（client/build 时注入） ==========
VITE_API_URL=https://your-domain.com/api
VITE_GAME_ENGINE_URL=https://game-engine.your-domain.com
VITE_WS_URL=wss://game-engine.your-domain.com/ws

# ========== Metabase 数据库 ==========
MB_DB_TYPE=postgres
MB_DB_DBNAME=poker_platform
MB_DB_PORT=5432
MB_DB_USER=poker_admin
MB_DB_PASS=__CHANGE_ME_STRONG_PASSWORD__
MB_DB_HOST=postgres
