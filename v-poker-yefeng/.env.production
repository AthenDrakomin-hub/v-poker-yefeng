# V-POKER 环境变量配置
# 使用方法：
#   生产环境：cp .env.production .env
#   测试环境：cp .env.test .env
#   开发环境：cp .env.development .env

# ========== 环境标识 ==========
ENV=production
APP_NAME=V-POKER
VERSION=1.0.0

# ========== PostgreSQL 数据库 ==========
# 生产数据库
POSTGRES_USER=poker_admin
POSTGRES_PASSWORD=PokerDB2024
POSTGRES_DB=poker_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 异步数据库连接字符串（Python 服务使用）
DATABASE_URL=postgresql+asyncpg://poker_admin:PokerDB2024@postgres:5432/poker_platform

# 同步数据库连接字符串（BFF 使用）
DATABASE_URL_SYNC=postgresql://poker_admin:PokerDB2024@postgres:5432/poker_platform

# ========== JWT 认证 ==========
JWT_SECRET=PokerJwtSecret2024!ChangeMeInProduction!
JWT_EXPIRE_HOURS=168

# ========== 服务端口 ==========
WALLET_SERVICE_PORT=8001
COMMISSION_SERVICE_PORT=8000
BFF_PORT=4000
GAME_ENGINE_PORT=8003

# ========== 游戏配置 ==========
PLATFORM_FEE_RATE=0.0300
AGENT_COMMISSION_RATE=0.0300
DISCONNECT_TIMEOUT_MS=300000

# ========== 其他服务地址 ==========
COMMISSION_SERVICE_URL=http://commission-service:8000
WALLET_SERVICE_URL=http://wallet-service:8001
GAME_ENGINE_URL=http://game-engine:8003

# ========== CORS 配置 ==========
CORS_ALLOWED_ORIGINS=https://goodspage.cn,http://localhost:3000

# ========== 调试模式 ==========
DEBUG=false
